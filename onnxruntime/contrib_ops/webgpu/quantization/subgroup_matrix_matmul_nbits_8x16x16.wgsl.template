// Intel SubgroupMatrix matmul_nbits kernel
// Uses subgroupMatrixLoad/Store/MultiplyAccumulate for hardware DPAS acceleration
//
// A: prepacked layout (from PrepackProgram) - elements arranged for subgroupMatrixLoad
// B: 4-bit or 8-bit quantized, dequantized into SLM (tile_b)
//
// Workgroup size and tile_m/tile_n (kTileM x kTileN) are caller-configurable; the number of
// subgroups per workgroup must equal kTileM / sg_mat_m (i.e. workgroup size = kTileM / sg_mat_m * 32).
// Each workgroup handles one (M-tile, N-tile) pair, decoded from a flattened workgroup_idx
// K dimension iterated in kTileK(32) blocks

#param n_bits
#param has_zero_points
#param has_bias
#param has_weight_idx
#param has_weight_idx_indirect
#param sg_mat_k
#param sg_mat_m
#param sg_mat_n
#param tile_m
#param tile_n

#use .getByOffset .setByOffset

#include "quantization/matmul_nbits_zero_pt.wgsl.template"

const kQuantizationBlockSize : u32 = 32;
const kValuesPerPack : u32 = 8;  // K-values dequantized per packed_data element (mat2x4 = 8 elements)
const kU32sPerBPack : u32 = 4;   // Number of packs loaded per kTileK cycle

const kTileM : u32 = u32(tile_m);                // Tile size along M (output rows per workgroup)
const kTileN : u32 = u32(tile_n);                // Tile size along N (output columns per workgroup)
const kTileK : u32 = 32;                         // Tile size along K (reduction dimension per iteration)
const kSgMatM : u32 = u32(sg_mat_m);             // Subgroup matrix M dimension (rows)
const kSgMatN : u32 = u32(sg_mat_n);             // Subgroup matrix N dimension (columns)
const kSgMatK : u32 = u32(sg_mat_k);             // Subgroup matrix K dimension (reduction)
const kSgMatLeftSize : u32 = kSgMatM * kSgMatK;  // Elements per left (A) subgroup matrix
const kSgMatStrideN : u32 = kSgMatN * kTileK;    // Stride between N blocks in tile_b
const kSgMatCountM : u32 = kTileM / kSgMatM;     // Number of subgroup matrices per tile along M
const kSgMatCountN : u32 = kTileN / kSgMatN;     // Number of subgroup matrices per tile along N
const kSgMatCountK : u32 = kTileK / kSgMatK;     // Number of subgroup_matrix K-substeps per kTileK block

alias SgMatLeft = subgroup_matrix_left<f16, sg_mat_k, sg_mat_m>;
alias SgMatRight = subgroup_matrix_right<f16, sg_mat_n, sg_mat_k>;
alias SgMatResult = subgroup_matrix_result<f16, sg_mat_n, sg_mat_m>;

// Shared local memory for dequantized B weights [kTileN, kTileK], column-major
var<workgroup> tile_b : array<f16, kTileN * kTileK>;

#if has_bias
// Scratch space for matmul results before bias addition [kTileM, kTileN], row-major
var<workgroup> scratch : array<f16, kTileM * kTileN>;
#endif

// --- Offset Helpers ---

fn get_weight_offset() -> u32 {
#if has_weight_idx
#if has_weight_idx_indirect
  let actual_weight_idx = weight_index_indirect.getByOffset(uniforms.weight_idx);
#else
  let actual_weight_idx = uniforms.weight_idx;
#endif
  return actual_weight_idx * uniforms.K * uniforms.N;
#else
  return 0u;
#endif
}

fn get_scale_offset() -> u32 {
#if has_weight_idx
#if has_weight_idx_indirect
  let actual_weight_idx = weight_index_indirect.getByOffset(uniforms.weight_idx);
#else
  let actual_weight_idx = uniforms.weight_idx;
#endif
  return actual_weight_idx * uniforms.N * (uniforms.K / kQuantizationBlockSize);
#else
  return 0u;
#endif
}

// --- Data Loading Functions ---

// scale_offset is resolved once per workgroup (see get_scale_offset), not recomputed per thread.
fn load_scale(row : u32, block_idx : u32, scale_offset : u32) -> output_element_t {
  if (row < uniforms.N && block_idx < uniforms.zero_blocks_per_col) {
    let offset = row * uniforms.zero_blocks_per_col + block_idx + scale_offset;
    return scales_b.getByOffset(offset);
  }
  return output_element_t();
}

#if n_bits == 4
alias InputBPack = vec4<u32>;
fn load_b(row : u32, block_idx : u32, weight_offset : u32) -> InputBPack {
  let k_of_b = uniforms.K / kQuantizationBlockSize;
  if (row < uniforms.N && block_idx < k_of_b) {
    let offset = row * k_of_b + block_idx + weight_offset;
    return input_b.getByOffset(offset);
  }
  return InputBPack();
}

fn dequantize(packed_data : u32,
              zero_point : output_element_t,
              scale : output_element_t) -> mat2x4<output_element_t> {
  let lower : vec4<u32> = unpack4xU8(packed_data & 0x0F0F0F0Fu);
  let upper : vec4<u32> = unpack4xU8((packed_data >> 4u) & 0x0F0F0F0Fu);

  let zero_mat : mat2x4<output_element_t> = mat2x4<output_element_t>(
                     zero_point, zero_point, zero_point, zero_point,
                     zero_point, zero_point, zero_point, zero_point);

  var val : mat2x4<output_element_t> = mat2x4<output_element_t>(
                output_element_t(lower[0]), output_element_t(upper[0]),
                output_element_t(lower[1]), output_element_t(upper[1]),
                output_element_t(lower[2]), output_element_t(upper[2]),
                output_element_t(lower[3]), output_element_t(upper[3]));

  return (val - zero_mat) * scale;
}
#endif

#if n_bits == 8
alias InputBPack = array<vec2<u32>, 4>;
fn load_b(row : u32, block_idx : u32, weight_offset : u32) -> InputBPack {
  let k_vec4_offset = block_idx * 2u;
  if (row < uniforms.N && k_vec4_offset + 1u < uniforms.K / 16u) {
    let k_vec4s = uniforms.K / 16u;
    let offset = row * k_vec4s + k_vec4_offset + weight_offset;

    // Natively read 32 bytes at once
    let v0 = input_b.getByOffset(offset);
    let v1 = input_b.getByOffset(offset + 1u);

    return array<vec2<u32>, 4>(
        v0.xy, v0.zw, v1.xy, v1.zw);
  }
  return InputBPack();
}

fn dequantize(packed_data : vec2<u32>,
              zero_point : output_element_t,
              scale : output_element_t) -> mat2x4<output_element_t> {
  let lower : vec4<u32> = unpack4xU8(packed_data.x);
  let upper : vec4<u32> = unpack4xU8(packed_data.y);

  let zero_mat : mat2x4<output_element_t> = mat2x4<output_element_t>(
                     zero_point, zero_point, zero_point, zero_point,
                     zero_point, zero_point, zero_point, zero_point);

  var val : mat2x4<output_element_t> = mat2x4<output_element_t>(
                output_element_t(lower[0]), output_element_t(lower[1]),
                output_element_t(lower[2]), output_element_t(lower[3]),
                output_element_t(upper[0]), output_element_t(upper[1]),
                output_element_t(upper[2]), output_element_t(upper[3]));

  return (val - zero_mat) * scale;
}
#endif

// --- Main Compute ---

$MAIN {
  // Resolve the (possibly indirect) weight index once per workgroup, not once per K-tile iteration.
  let scale_offset = get_scale_offset();
#if n_bits == 4
  let weight_offset = get_weight_offset() / 32u;
#elif n_bits == 8
  let weight_offset = get_weight_offset() / 16u;
#else
  let weight_offset = 0u;
#endif

  let m_tile = (workgroup_idx / uniforms.num_N_tile) % uniforms.num_M_tile;

  let global_base_m = m_tile * kTileM;
  let global_base_n = (workgroup_idx % uniforms.num_N_tile) * kTileN;

  let sg_idx = u32(local_idx / sg_size);

  let sg_mat_count_k = uniforms.K / kSgMatK;
  var sg_mat_offset_a = (m_tile * kSgMatCountM + sg_idx) * sg_mat_count_k * kSgMatLeftSize;

  var sg_mat_acc : array<SgMatResult, kSgMatCountN>;

  for (var k_idx : u32 = 0; k_idx < uniforms.K; k_idx += kTileK) {
    if (local_idx < kTileN) {
      let global_n = global_base_n + local_idx;
      let b_col = k_idx / kQuantizationBlockSize;
      let tile_offset = local_idx * kTileK;

      let b_data = load_b(global_n, b_col, weight_offset);
      let scale = load_scale(global_n, b_col, scale_offset);
      let zero_point = mm_read_zero(global_n, b_col, uniforms.N, uniforms.zero_blocks_per_col);

      for (var pack_idx = 0u; pack_idx < kU32sPerBPack; pack_idx++) {
        let b_dequantized = dequantize(b_data[pack_idx], zero_point, scale);
        let k_offset = pack_idx * kValuesPerPack;
        for (var elem_idx = 0u; elem_idx < kValuesPerPack; elem_idx++) {
          tile_b[tile_offset + k_offset + elem_idx] = b_dequantized[elem_idx / 4u][elem_idx % 4u];
        }
      }
    }
    workgroupBarrier();

    for (var sg_mat_k_idx = 0u; sg_mat_k_idx < kSgMatCountK; sg_mat_k_idx++) {
      var sg_mat_a : SgMatLeft = subgroupMatrixLoad<SgMatLeft, row_major>(&input_a,
                                                                          sg_mat_offset_a,
                                                                          kSgMatK);
      sg_mat_offset_a += kSgMatLeftSize;

      for (var sg_mat_n_idx = 0u; sg_mat_n_idx < kSgMatCountN; sg_mat_n_idx++) {
        var sg_mat_b : SgMatRight = subgroupMatrixLoad<SgMatRight, col_major>(&tile_b,
                                                                              sg_mat_k_idx * kSgMatK + sg_mat_n_idx * kSgMatStrideN,
                                                                              kTileK);

        sg_mat_acc[sg_mat_n_idx] = subgroupMatrixMultiplyAccumulate(sg_mat_a, sg_mat_b, sg_mat_acc[sg_mat_n_idx]);
      }
    }
    workgroupBarrier();
  }

  // Write out
#if has_bias
  let scratch_m_base = sg_idx * kSgMatM;
  for (var sg_mat_n_idx = 0u; sg_mat_n_idx < kSgMatCountN; sg_mat_n_idx++) {
    subgroupMatrixStore<row_major>(&scratch,
                                   scratch_m_base * kTileN + sg_mat_n_idx * kSgMatN,
                                   sg_mat_acc[sg_mat_n_idx],
                                   kTileN);
  }
  workgroupBarrier();

  let ThreadsPerMRow = workgroup_size_x / kTileM;  // Threads cooperatively writing each M row
  let ElemsPerThreadRow = kTileN / ThreadsPerMRow;  // N-elements each thread writes per row
  let out_m = local_idx / ThreadsPerMRow;
  let out_n_base = (local_idx % ThreadsPerMRow) * ElemsPerThreadRow;
  let out_global_m = global_base_m + out_m;
  if (out_global_m < uniforms.M) {
    let out_global_n_base = global_base_n + out_n_base;
    let scratch_base = out_m * kTileN + out_n_base;
    let out_base = out_global_m * uniforms.N + out_global_n_base;
#if has_weight_idx_indirect
    let bias_offset = weight_index_indirect.getByOffset(uniforms.weight_idx) * uniforms.N;
#elif has_weight_idx
    let bias_offset = uniforms.weight_idx * uniforms.N;
#else
    const bias_offset : u32 = 0;
#endif
    for (var i : u32 = 0; i < ElemsPerThreadRow; i++) {
      if (out_global_n_base + i < uniforms.N) {
        let val = f16(scratch[scratch_base + i]) + bias.getByOffset(bias_offset + out_global_n_base + i);
        output.setByOffset(out_base + i, val);
      }
    }
  }
#else
  for (var sg_mat_n_idx = 0u; sg_mat_n_idx < kSgMatCountN; sg_mat_n_idx++) {
    subgroupMatrixStore<row_major>(&output,
                                   global_base_m * uniforms.N + global_base_n + sg_idx * kSgMatM * uniforms.N + sg_mat_n_idx * kSgMatN,
                                   sg_mat_acc[sg_mat_n_idx],
                                   uniforms.N);
  }
#endif
}  // MAIN
