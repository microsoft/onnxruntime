// Intel SubgroupMatrix matmul_nbits kernel
// Uses subgroupMatrixLoad/Store/MultiplyAccumulate for hardware DPAS acceleration
//
// A: prepacked layout (from PrepackProgram) - elements arranged for subgroupMatrixLoad
// B: 4-bit or 8-bit quantized, dequantized into SLM (tile_b).
//
// Workgroup size and tile_m/tile_n (kTileM x kTileN) are caller-configurable; the number of
// subgroups per workgroup must equal kTileM / sg_mat_m (i.e. workgroup size = kTileM / sg_mat_m * 32).
// Each workgroup handles one (M-tile, N-tile) pair, decoded from a flattened workgroup_idx
// K dimension iterated in kChunkSizeK(32) blocks

#param n_bits
#param has_zero_points
#param has_bias
#param has_tail_buffer
#param has_weight_idx
#param has_weight_idx_indirect
#param sg_mat_k
#param sg_mat_m
#param sg_mat_n
#param tile_m
#param tile_n

#use .getByOffset .setByOffset

#include "quantization/matmul_nbits_zero_pt.wgsl.template"

// A pack is the load/dequantization unit for eight consecutive K-elements of one B row.
// It is stored as a u32 for 4-bit weights or a vec2<u32> for 8-bit weights.
// Four packs form a 32-element quantization block and share its scale and zero point.
#if n_bits == 4
alias PackT = u32;          // one pack = one nibble-packed u32 word (8 values)
#elif n_bits == 8
alias PackT = vec2<u32>;    // one pack = one byte-packed vec2<u32> (8 values)
#endif

const kQuantizationBlockSize : u32 = 32;
const kPacksPerBlock : u32 = 4;   // Packs per quantization block, both n_bits
const kElementsPerPack : u32 = 8; // K-elements dequantized per pack, both n_bits

const kTileM : u32 = u32(tile_m);                // Tile size along M (output rows per workgroup)
const kTileN : u32 = u32(tile_n);                // Tile size along N (output columns per workgroup)
const kChunkSizeK : u32 = 32;                    // Tile size along K (reduction dimension per iteration)
const kSgMatDimM : u32 = u32(sg_mat_m);        // Subgroup matrix M dimension (rows)
const kSgMatDimN : u32 = u32(sg_mat_n);        // Subgroup matrix N dimension (columns)
const kSgMatDimK : u32 = u32(sg_mat_k);        // Subgroup matrix K dimension (reduction)
const kSgMatLeftSize : u32 = kSgMatDimM * kSgMatDimK;  // Elements per left (A) subgroup matrix
const kSgMatStrideN : u32 = kSgMatDimN * kChunkSizeK;  // Stride between N blocks in tile_b
const kSgMatCountM : u32 = kTileM / kSgMatDimM;        // Number of subgroup matrices per tile along M
const kSgMatCountN : u32 = kTileN / kSgMatDimN;        // Number of subgroup matrices per tile along N
const kSgMatCountK : u32 = kChunkSizeK / kSgMatDimK;   // Number of subgroup_matrix K-substeps per kChunkSizeK block

alias SgMatLeft = subgroup_matrix_left<f16, sg_mat_k, sg_mat_m>;
alias SgMatRight = subgroup_matrix_right<f16, sg_mat_n, sg_mat_k>;
alias SgMatResult = subgroup_matrix_result<f16, sg_mat_n, sg_mat_m>;

// Shared local memory for dequantized B weights [kTileN, kChunkSizeK], column-major
var<workgroup> tile_b : array<f16, kTileN * kChunkSizeK>;

#if has_bias
// Scratch space for bounds-checked write-out with bias addition, [kTileM, kTileN],
// row-major. The no-bias path never needs this - see `has_tail_buffer` below.
var<workgroup> scratch : array<f16, kTileM * kTileN>;
#endif

// --- Data Loading Functions ---

// scale_offset is resolved before the K loop, not recomputed for each load.
// Note: the scales buffer is strided by blocks-per-row (K / kQuantizationBlockSize), which is
// NOT the same as uniforms.zero_blocks_per_col (that's padded to a zero-point byte boundary).
fn load_scale(row : u32, block_idx : u32, scale_offset : u32) -> output_element_t {
  let blocks_per_col = uniforms.K / kQuantizationBlockSize;
  let offset = row * blocks_per_col + block_idx + scale_offset;
  return scales_b.getByOffset(offset);
}

// Fetches a single pack of raw B data (one u32 word for n_bits=4, one
// vec2<u32> for n_bits=8), addressed by its flat pack index within the row
// (row * packs_per_row + pack_idx), offset by weight_offset (in block units,
// scaled up to pack units here).
fn load_b(row : u32, pack_idx : u32, weight_offset : u32) -> PackT {
  let k_of_b = uniforms.K / kQuantizationBlockSize;
  let packs_per_row = k_of_b * kPacksPerBlock;
  let offset = row * packs_per_row + pack_idx + weight_offset * kPacksPerBlock;
  return input_b.getByOffset(offset);
}

// --- Main Compute ---

$MAIN {
  // Resolve the (possibly indirect) weight index once per workgroup.
#if has_weight_idx_indirect
  let actual_weight_idx = weight_index_indirect[uniforms.weight_idx];
#elif has_weight_idx
  let actual_weight_idx = uniforms.weight_idx;
#else
  let actual_weight_idx = 0u;
#endif
  let scale_offset = actual_weight_idx * uniforms.N * (uniforms.K / kQuantizationBlockSize);
  // One scale per block; load_b converts the shared block offset to pack units.
  let weight_offset = scale_offset;

  let m_tile = (workgroup_idx / uniforms.num_N_tile) % uniforms.num_M_tile;

  let global_base_m = m_tile * kTileM;
  let global_base_n = (workgroup_idx % uniforms.num_N_tile) * kTileN;

  let sg_idx = u32(local_idx / sg_size);
  var sg_mat_offset_a = (m_tile * kSgMatCountM + sg_idx) * (uniforms.K / kSgMatDimK) * kSgMatLeftSize;

  var sg_mat_acc : array<SgMatResult, kSgMatCountN>;
  for (var k_idx : u32 = 0; k_idx < uniforms.K; k_idx += kChunkSizeK) {
    let k_block_idx = k_idx / kQuantizationBlockSize;
    for (var load_unit = local_idx; load_unit < kTileN * kPacksPerBlock; load_unit += workgroup_size_x) {
      let n_idx = load_unit / kPacksPerBlock;
      let pack_idx = load_unit % kPacksPerBlock;
      let global_n = global_base_n + n_idx;
      let tile_b_offset = n_idx * kChunkSizeK + pack_idx * kElementsPerPack;

      if (global_n < uniforms.N) {
        let packed = load_b(global_n, k_block_idx * kPacksPerBlock + pack_idx, weight_offset);
        let scale = load_scale(global_n, k_block_idx, scale_offset);
        let zero_point = mm_read_zero(actual_weight_idx, global_n, k_block_idx,
                                      uniforms.N, uniforms.zero_blocks_per_col);
#if n_bits == 4
        let lower =
            (vec4<output_element_t>(unpack4xU8(packed & 0x0F0F0F0Fu)) - vec4<output_element_t>(zero_point)) * scale;
        let upper =
            (vec4<output_element_t>(unpack4xU8((packed >> 4u) & 0x0F0F0F0Fu)) - vec4<output_element_t>(zero_point)) * scale;
        tile_b[tile_b_offset] = lower[0];
        tile_b[tile_b_offset + 1u] = upper[0];
        tile_b[tile_b_offset + 2u] = lower[1];
        tile_b[tile_b_offset + 3u] = upper[1];
        tile_b[tile_b_offset + 4u] = lower[2];
        tile_b[tile_b_offset + 5u] = upper[2];
        tile_b[tile_b_offset + 6u] = lower[3];
        tile_b[tile_b_offset + 7u] = upper[3];
#elif n_bits == 8
        let lower =
            (vec4<output_element_t>(unpack4xU8(packed.x)) - vec4<output_element_t>(zero_point)) * scale;
        let upper =
            (vec4<output_element_t>(unpack4xU8(packed.y)) - vec4<output_element_t>(zero_point)) * scale;
        tile_b[tile_b_offset] = lower[0];
        tile_b[tile_b_offset + 1u] = lower[1];
        tile_b[tile_b_offset + 2u] = lower[2];
        tile_b[tile_b_offset + 3u] = lower[3];
        tile_b[tile_b_offset + 4u] = upper[0];
        tile_b[tile_b_offset + 5u] = upper[1];
        tile_b[tile_b_offset + 6u] = upper[2];
        tile_b[tile_b_offset + 7u] = upper[3];
#endif
      }
    }
    workgroupBarrier();

    for (var sg_mat_k_idx = 0u; sg_mat_k_idx < kSgMatCountK; sg_mat_k_idx++) {
      var sg_mat_a : SgMatLeft = subgroupMatrixLoad<SgMatLeft, row_major>(&input_a,
                                                                          sg_mat_offset_a,
                                                                          kSgMatDimK);
      sg_mat_offset_a += kSgMatLeftSize;

      var sg_mat_offset_b = sg_mat_k_idx * kSgMatDimK;
      for (var sg_mat_n_idx = 0u; sg_mat_n_idx < kSgMatCountN; sg_mat_n_idx++) {
        var sg_mat_b : SgMatRight = subgroupMatrixLoad<SgMatRight, col_major>(&tile_b,
                                                                              sg_mat_offset_b,
                                                                              kChunkSizeK);
        sg_mat_offset_b += kSgMatStrideN;

        sg_mat_acc[sg_mat_n_idx] = subgroupMatrixMultiplyAccumulate(sg_mat_a, sg_mat_b, sg_mat_acc[sg_mat_n_idx]);
      }
    }
    workgroupBarrier();
  }

  // Write out
#if has_bias
  let scratch_store_base = sg_idx * kSgMatDimM * kTileN;
  for (var sg_mat_n_idx = 0u; sg_mat_n_idx < kSgMatCountN; sg_mat_n_idx++) {
    subgroupMatrixStore<row_major>(&scratch,
                                   scratch_store_base + sg_mat_n_idx * kSgMatDimN,
                                   sg_mat_acc[sg_mat_n_idx],
                                   kTileN);
  }
  workgroupBarrier();

  let ThreadsPerMRow = workgroup_size_x / kTileM;  // Threads cooperatively writing each M row
  let ElemsPerThreadRow = kTileN / ThreadsPerMRow;  // N-elements each thread writes per row
  let out_m = local_idx / ThreadsPerMRow;
  let out_n_base = (local_idx % ThreadsPerMRow) * ElemsPerThreadRow;
  let out_global_m = global_base_m + out_m;
  if (out_global_m < uniforms.M) {
    let out_global_n_base = global_base_n + out_n_base;
    let scratch_base = out_m * kTileN + out_n_base;
    let out_base = out_global_m * uniforms.N + out_global_n_base;
#if has_weight_idx_indirect
    let bias_offset = weight_index_indirect[uniforms.weight_idx] * uniforms.N;
#elif has_weight_idx
    let bias_offset = uniforms.weight_idx * uniforms.N;
#else
    const bias_offset : u32 = 0;
#endif
    for (var i : u32 = 0; i < ElemsPerThreadRow; i++) {
      if (out_global_n_base + i < uniforms.N) {
        let val = f16(scratch[scratch_base + i]) + bias[bias_offset + out_global_n_base + i];
        output.setByOffset(out_base + i, val);
      }
    }
  }
#else
  // A trailing M-tile may be partial (M is not required to be a multiple of
  // kTileM). Writing it with subgroupMatrixStore straight to output would run
  // past M. That's not just an out-of-bounds risk: a subgroupMatrixStore whose
  // footprint leaves the buffer does not degrade to a per-element clamp or zero
  // fill - Tint's robustness transform resets the whole store to offset 0 with
  // the minimum stride, so it would silently overwrite a different, valid region
  // of the buffer (e.g. row 0) instead.
#if has_tail_buffer
  // Every tile - including the tail one - still writes via the same
  // branch-free fast path (no per-element bounds check, no workgroup
  // scratch); the tail tile targets a [kTileM, N] padded `tail_output`
  // buffer instead of `output` (which is too short by this point).
  // ApplySubgroupMatrixMatMulNBits crops the valid rows back into the real
  // output with a follow-up copy dispatch.
  if (global_base_m + kTileM <= uniforms.M) {
    let out_base = (global_base_m + sg_idx * kSgMatDimM) * uniforms.N + global_base_n;
    for (var sg_mat_n_idx = 0u; sg_mat_n_idx < kSgMatCountN; sg_mat_n_idx++) {
      subgroupMatrixStore<row_major>(&output,
                                     out_base + sg_mat_n_idx * kSgMatDimN,
                                     sg_mat_acc[sg_mat_n_idx],
                                     uniforms.N);
    }
  } else {
    let out_base = sg_idx * kSgMatDimM * uniforms.N + global_base_n;
    for (var sg_mat_n_idx = 0u; sg_mat_n_idx < kSgMatCountN; sg_mat_n_idx++) {
      subgroupMatrixStore<row_major>(&tail_output,
                                     out_base + sg_mat_n_idx * kSgMatDimN,
                                     sg_mat_acc[sg_mat_n_idx],
                                     uniforms.N);
    }
  }
#else
  // ApplySubgroupMatrixMatMulNBits only sets has_tail_buffer when M isn't a
  // multiple of kTileM, so here M is guaranteed aligned: every tile -
  // including the last - is always fully in bounds.
  let out_base = (global_base_m + sg_idx * kSgMatDimM) * uniforms.N + global_base_n;
  for (var sg_mat_n_idx = 0u; sg_mat_n_idx < kSgMatCountN; sg_mat_n_idx++) {
    subgroupMatrixStore<row_major>(&output,
                                   out_base + sg_mat_n_idx * kSgMatDimN,
                                   sg_mat_acc[sg_mat_n_idx],
                                   uniforms.N);
  }
#endif
#endif
}  // MAIN
