#use .getByOffset .setByOffset

alias ActivationMatrix = subgroup_matrix_left<f32, 8, 8>;
alias WeightMatrix = subgroup_matrix_right<f32, 8, 8>;
alias Accumulator = subgroup_matrix_result<f32, 8, 8>;

const weight_tile_offset = 1024u;

// A: 64x16 row-major; B: 16x64 column-major, starting at weight_tile_offset.
// Input tiles occupy 2,048 floats. Reuse the allocation for the 64x64 output
// only after every subgroup has finished reading the final input tiles.
var<workgroup> shared_tile: array<f32, 4096>;

$MAIN {
  let subgroup_index = subgroupBroadcastFirst(local_idx) / 32u;
  let row_base = (workgroup_idx / uniforms.num_N_tile) * 64u;
  let col_base = (workgroup_idx % uniforms.num_N_tile) * 64u;
  // Each subgroup owns 64x16 outputs: eight rows of two 8x8 accumulator tiles.
  var c00: Accumulator;
  var c01: Accumulator;
  var c10: Accumulator;
  var c11: Accumulator;
  var c20: Accumulator;
  var c21: Accumulator;
  var c30: Accumulator;
  var c31: Accumulator;
  var c40: Accumulator;
  var c41: Accumulator;
  var c50: Accumulator;
  var c51: Accumulator;
  var c60: Accumulator;
  var c61: Accumulator;
  var c70: Accumulator;
  var c71: Accumulator;

  for (var k_base = 0u; k_base < uniforms.K; k_base += 16u) {
    for (var i = local_idx; i < 256u; i += 128u) {
      let global_row = row_base + i / 4u;
      var a_values = vec4<f32>(0);
      if (global_row < uniforms.M) {
        a_values = vec4<f32>(a.getByOffset(global_row * (uniforms.K / 4u) + k_base / 4u + i % 4u));
      }
      for (var j = 0u; j < 4u; j++) {
        shared_tile[i * 4u + j] = a_values[j];
      }
    }

    // Each lane unpacks eight weights; two lanes fill one 16-element column.
    let global_col = col_base + local_idx / 2u;
    let weight_k = k_base + (local_idx % 2u) * 8u;
    var packed = 0u;
    var scale = 0h;
    if (global_col < uniforms.N) {
      let index = global_col * (uniforms.K / 32u) + weight_k / 32u;
      packed = b.getByOffset(index)[(weight_k % 32u) / 8u];
      scale = scales.getByOffset(index);
    }
    for (var j = 0u; j < 8u; j++) {
      // Match FP16 weight dequantization before promoting matrix operands.
      shared_tile[weight_tile_offset + local_idx * 8u + j] = f32((f16((packed >> (j * 4u)) & 15u) - 8h) * scale);
    }
    workgroupBarrier();

    for (var step = 0u; step < 16u; step += 8u) {
      let a0 = subgroupMatrixLoad<ActivationMatrix, row_major>(&shared_tile, step, 16u);
      let a1 = subgroupMatrixLoad<ActivationMatrix, row_major>(&shared_tile, 128u + step, 16u);
      let a2 = subgroupMatrixLoad<ActivationMatrix, row_major>(&shared_tile, 256u + step, 16u);
      let a3 = subgroupMatrixLoad<ActivationMatrix, row_major>(&shared_tile, 384u + step, 16u);
      let a4 = subgroupMatrixLoad<ActivationMatrix, row_major>(&shared_tile, 512u + step, 16u);
      let a5 = subgroupMatrixLoad<ActivationMatrix, row_major>(&shared_tile, 640u + step, 16u);
      let a6 = subgroupMatrixLoad<ActivationMatrix, row_major>(&shared_tile, 768u + step, 16u);
      let a7 = subgroupMatrixLoad<ActivationMatrix, row_major>(&shared_tile, 896u + step, 16u);
      let b0 = subgroupMatrixLoad<WeightMatrix, col_major>(
          &shared_tile, weight_tile_offset + (subgroup_index * 16u) * 16u + step, 16u);
      let b1 = subgroupMatrixLoad<WeightMatrix, col_major>(
          &shared_tile, weight_tile_offset + (subgroup_index * 16u + 8u) * 16u + step, 16u);
      c00 = subgroupMatrixMultiplyAccumulate(a0, b0, c00);
      c01 = subgroupMatrixMultiplyAccumulate(a0, b1, c01);
      c10 = subgroupMatrixMultiplyAccumulate(a1, b0, c10);
      c11 = subgroupMatrixMultiplyAccumulate(a1, b1, c11);
      c20 = subgroupMatrixMultiplyAccumulate(a2, b0, c20);
      c21 = subgroupMatrixMultiplyAccumulate(a2, b1, c21);
      c30 = subgroupMatrixMultiplyAccumulate(a3, b0, c30);
      c31 = subgroupMatrixMultiplyAccumulate(a3, b1, c31);
      c40 = subgroupMatrixMultiplyAccumulate(a4, b0, c40);
      c41 = subgroupMatrixMultiplyAccumulate(a4, b1, c41);
      c50 = subgroupMatrixMultiplyAccumulate(a5, b0, c50);
      c51 = subgroupMatrixMultiplyAccumulate(a5, b1, c51);
      c60 = subgroupMatrixMultiplyAccumulate(a6, b0, c60);
      c61 = subgroupMatrixMultiplyAccumulate(a6, b1, c61);
      c70 = subgroupMatrixMultiplyAccumulate(a7, b0, c70);
      c71 = subgroupMatrixMultiplyAccumulate(a7, b1, c71);
    }
    // Protect the input tiles until every subgroup has consumed them.
    workgroupBarrier();
  }

  // Reuse shared memory to convert the distributed FP32 results to FP16 output.
  subgroupMatrixStore<row_major>(&shared_tile, subgroup_index * 16u, c00, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, subgroup_index * 16u + 8u, c01, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 512u + subgroup_index * 16u, c10, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 512u + subgroup_index * 16u + 8u, c11, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 1024u + subgroup_index * 16u, c20, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 1024u + subgroup_index * 16u + 8u, c21, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 1536u + subgroup_index * 16u, c30, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 1536u + subgroup_index * 16u + 8u, c31, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 2048u + subgroup_index * 16u, c40, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 2048u + subgroup_index * 16u + 8u, c41, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 2560u + subgroup_index * 16u, c50, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 2560u + subgroup_index * 16u + 8u, c51, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 3072u + subgroup_index * 16u, c60, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 3072u + subgroup_index * 16u + 8u, c61, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 3584u + subgroup_index * 16u, c70, 64u);
  subgroupMatrixStore<row_major>(&shared_tile, 3584u + subgroup_index * 16u + 8u, c71, 64u);
  workgroupBarrier();
  for (var i = local_idx; i < 4096u; i += 128u) {
    let global_row = row_base + i / 64u;
    let global_col = col_base + i % 64u;
    if (global_row < uniforms.M && global_col < uniforms.N) {
      output.setByOffset(global_row * uniforms.N + global_col, f16(shared_tile[i]));
    }
  }
}
