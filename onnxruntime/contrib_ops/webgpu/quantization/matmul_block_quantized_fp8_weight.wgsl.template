#param has_bias
#param use_matrix
#use .getByOffset .setByOffset

fn decode_fp8(code: u32) -> f32 {
  let exponent = (code >> 3u) & 15u;
  let mantissa = code & 7u;
  let magnitude = select(f32(mantissa) * 0.001953125,
                         bitcast<f32>(((exponent + 120u) << 23u) | (mantissa << 20u)),
                         exponent != 0u);
  let value = select(magnitude, -magnitude, (code & 128u) != 0u);
  return select(value, bitcast<f32>(0x7fc00000u | code), exponent == 15u && mantissa == 7u);
}

fn weight(n: u32, k: u32) -> f16 {
  let offset = n * uniforms.K + k;
  let code = (weights.getByOffset(offset / 4u) >> ((offset % 4u) * 8u)) & 255u;
  return f16(decode_fp8(code) * scales.getByOffset(n * uniforms.K_blocks + k / uniforms.block_size));
}

#if use_matrix
// The padded workgroup tiles make every subgroup-matrix load and store in bounds.
var<workgroup> tile_a: array<f16, 1024>;
var<workgroup> tile_b: array<f16, 256>;
var<workgroup> tile_y: array<f32, 1024>;
#else
var<workgroup> partial: array<f32, 32>;
#endif
$MAIN {
#if use_matrix
  let lane = local_idx;
  let m_base = workgroup_id.y * 64u;
  let n_base = workgroup_id.x * 16u;
  var acc: subgroup_matrix_result<f32, 16, 16>;
  for (var tile = 0u; tile < (uniforms.K + 15u) / 16u; tile++) {
    let k_base = tile * 16u;
    for (var i = lane; i < 1024u; i += 128u) {
      let m = m_base + i / 16u;
      let k = k_base + i % 16u;
      tile_a[i] = f16(0);
      if (m < uniforms.M && k < uniforms.K) {
        tile_a[i] = input_a.getByOffset(m * uniforms.K + k);
      }
    }
    for (var i = lane; i < 256u; i += 128u) {
      let n = n_base + i / 16u;
      let k = k_base + i % 16u;
      tile_b[i] = f16(0);
      if (n < uniforms.N && k < uniforms.K) {
        tile_b[i] = weight(n, k);
      }
    }
    workgroupBarrier();
    let left = subgroupMatrixLoad<subgroup_matrix_left<f16, 16, 16>, row_major>(
        &tile_a, (lane / 32u) * 256u, 16u);
    let right = subgroupMatrixLoad<subgroup_matrix_right<f16, 16, 16>, col_major>(&tile_b, 0u, 16u);
    acc = subgroupMatrixMultiplyAccumulate(left, right, acc);
    workgroupBarrier();
  }
  subgroupMatrixStore<row_major>(&tile_y, (lane / 32u) * 256u, acc, 16u);
  workgroupBarrier();
  for (var i = lane; i < 1024u; i += 128u) {
    let m = m_base + i / 16u;
    let n = n_base + i % 16u;
    if (m < uniforms.M && n < uniforms.N) {
      var value = tile_y[i];
#if has_bias
      value += f32(bias.getByOffset(n));
#endif
      output.setByOffset(m * uniforms.N + n, f16(value));
    }
  }
#else
  let lane = local_idx;
  let m = workgroup_id.y;
  let n = workgroup_id.x;
  var sum = 0.0;
  for (var k = lane; k < uniforms.K; k += 32u) {
    sum += f32(input_a.getByOffset(m * uniforms.K + k)) * f32(weight(n, k));
  }
  partial[lane] = sum;
  workgroupBarrier();
  for (var stride = 16u; stride > 0u; stride /= 2u) {
    if (lane < stride) {
      partial[lane] += partial[lane + stride];
    }
    workgroupBarrier();
  }
  if (lane == 0u) {
    var value = partial[0];
#if has_bias
    value += f32(bias.getByOffset(n));
#endif
    output.setByOffset(m * uniforms.N + n, f16(value));
  }
#endif
}
