#param acc_f32
#param block_size
#param n_bits
#param has_qlora_up
#param has_bias
#param has_zero_points
#param is_qualcomm
#param has_weight_idx
#param has_weight_idx_indirect
#param tile_size_k_vec
#param tile_size_m
#param tile_size_n
#param workgroup_size

#use .getByOffset .setByOffset


fn write_qlora_output(offset: u32, value: vec4<output_element_t>) {
#if has_qlora_up
  let row = (offset * 4u) / uniforms.N;
  let col = (offset * 4u) % uniforms.N;
  let delta = qlora_delta4(row, col);
  output.setByOffset(offset, value + delta);
#else
  output.setByOffset(offset, value);
#endif
}


#include "quantization/dp4a_matmul_common.wgsl.template"

// Each 16-thread group computes a 16x16 output subtile. Rectangular workgroup
// tiles avoid wasting half the columns on narrow projections. Wider K loads
// amortize barriers while retaining the original 32-element dot/scale order.
// A is dynamically INT8-quantized per 128 elements; B uses its model block size.

const subtiles_n = tile_size_n / 16;
const subtile_size = 16;
const vec_factor = 4;
const u32_factor = 4;


// Shared memory
var<workgroup> tile_A : array<array<vec4<u32>, tile_size_m>, tile_size_k_vec>;
var<workgroup> scale_A : array<output_element_t, tile_size_m>;
var<workgroup> tile_B : array<array<vec4<u32>, tile_size_n>, tile_size_k_vec>;
var<workgroup> scale_B : array<output_element_t, tile_size_n * tile_size_k_vec / 2>;

#if has_zero_points
    var<workgroup> zeroes : array<i32, tile_size_n * tile_size_k_vec / 2>;
#endif

fn loadSHMA(batch:u32, a_global_base:u32, kidx_v:u32, row: u32, col: u32)
{
    let a_global = a_global_base + row;
    if (a_global >= uniforms.M)
    {
        return;
    }
    tile_A[col][row] = a.getByOffset(batch*uniforms.M*uniforms.K16+a_global*uniforms.K16+kidx_v+col);
    // A 128-value quantization block shares its scale across four 32-value K tiles.
    if (col == 0 && kidx_v % 8u == 0u)
    {
        scale_A[row] = scales_a.getByOffset(batch*uniforms.M*(uniforms.K/128) + a_global*(uniforms.K/128) + kidx_v/8);
    }
}

#if n_bits == 4
    fn loadSHMB(b_global_base:u32, kidx_v:u32, row: u32, col: u32)
    {
        let b_global = b_global_base + row;
        if (b_global >= uniforms.N)
        {
            return;
        }
#if has_weight_idx
#if has_weight_idx_indirect
        let actual_weight_idx = weight_index_indirect[uniforms.weight_idx];
#else
        let actual_weight_idx = uniforms.weight_idx;
#endif
        let b_weight_offset = actual_weight_idx * uniforms.N * uniforms.K16;
        let b_value = b.getByOffset(b_weight_offset + b_global * uniforms.K16 + kidx_v + col);
#else
        const actual_weight_idx : u32 = 0;
        let b_value = b.getByOffset(b_global * uniforms.K16+kidx_v + col);
#endif
        let block_idx = (kidx_v + col)/(block_size/16);
        let zero = mm_read_zero(actual_weight_idx, b_global, block_idx, uniforms.N, uniforms.zero_blocks_per_col);
        tile_B[col][row] = DequantizedFrom4BitsTo8Bits(b_value, zero);
        if (col % 2u == 0u)
        {
            // kidx_v - each kidx_v covers 16 values of k
            let b_scale_offset = actual_weight_idx * uniforms.N * (uniforms.K/block_size);
            scale_B[(col / 2u) * tile_size_n + row] = scales_b.getByOffset(b_scale_offset + b_global*(uniforms.K/block_size) + block_idx);
        }
    }
#endif

#if n_bits == 8
    fn loadSHMB(b_global_base:u32, kidx_v:u32, row: u32, col: u32)
    {
        let b_global = b_global_base + row;
        if (b_global >= uniforms.N)
        {
            return;
        }

#if has_weight_idx
#if has_weight_idx_indirect
        let actual_weight_idx = weight_index_indirect[uniforms.weight_idx];
#else
        let actual_weight_idx = uniforms.weight_idx;
#endif
        let b_weight_offset = actual_weight_idx * uniforms.N * uniforms.K16;
        let b_value = b.getByOffset(b_weight_offset + b_global * uniforms.K16 + kidx_v + col);
#else
        const actual_weight_idx : u32 = 0;
        const b_weight_offset : u32 = 0;
        let b_value = b.getByOffset(b_global * uniforms.K16 + kidx_v + col);
#endif
        tile_B[col][row] = AlignWithZeroPoint(b_value);
        if (col % 2u == 0u)
        {
            // kidx_v - each kidx_v covers 16 values of k
            let block_idx = (kidx_v + col)/(block_size/16);
            let b_scale_offset = actual_weight_idx * uniforms.N * (uniforms.K/block_size);
            scale_B[(col / 2u) * tile_size_n + row] = scales_b.getByOffset(b_scale_offset + b_global*(uniforms.K/block_size) + block_idx);
#if has_zero_points
            zeroes[(col / 2u) * tile_size_n + row] = mm_read_zero(actual_weight_idx, b_global, block_idx, uniforms.N, uniforms.zero_blocks_per_col);
#endif
        }
    }
#endif

#if n_bits == 2
    fn loadSHMB(b_global_base:u32, kidx_v:u32, row: u32, col: u32)
    {
        let b_global = b_global_base + row;
        if (b_global >= uniforms.N)
        {
            return;
        }
#if has_weight_idx
#if has_weight_idx_indirect
        let actual_weight_idx = weight_index_indirect[uniforms.weight_idx];
#else
        let actual_weight_idx = uniforms.weight_idx;
#endif
        let b_weight_offset = actual_weight_idx * uniforms.N * uniforms.K16;
        let b_value = b.getByOffset(b_weight_offset + b_global * uniforms.K16 + kidx_v + col);
#else
        const actual_weight_idx : u32 = 0;
        const b_weight_offset : u32 = 0;
        let b_value = b.getByOffset(b_global * uniforms.K16 + kidx_v + col);
#endif
        let block_idx = (kidx_v + col)/(block_size/16);
#if has_zero_points
        let zero = mm_read_zero(actual_weight_idx, b_global, block_idx, uniforms.N, uniforms.zero_blocks_per_col);
        tile_B[col][row] = DequantizedFrom2BitsTo8Bits(b_value, zero);
#else
        tile_B[col][row] = DequantizedFrom2BitsTo8Bits(b_value);
#endif
        if (col % 2u == 0u) {
            let b_scale_offset = actual_weight_idx * uniforms.N * (uniforms.K/block_size);
            scale_B[(col / 2u) * tile_size_n + row] = scales_b.getByOffset(b_scale_offset + b_global*(uniforms.K/block_size) + block_idx);
        }
    }
#endif

// Precision of the cross-tile accumulator, selected by the
// "enableMatmulFp32Accumulation" provider option. SDP8AI is an exact integer
// dot4I8Packed dot product; it is the accumulation across K tiles that can saturate f16.
#if acc_f32
alias acc_element_t = f32;
#else
alias acc_element_t = output_element_t;
#endif

$MAIN {
#if n_bits == 2
#if has_zero_points
    const table_size = 1024u;
#else
    const table_size = 256u;
#endif
    for (var i = local_idx; i < table_size; i += workgroup_size) {
        LoadDequantizationTable(i);
    }
    workgroupBarrier();
#endif
    let batch = workgroup_idx / (uniforms.num_M_tile * uniforms.num_N_tile);
    if (batch >= uniforms.batch_count) {
        return;
    }
    let a_global_base = u32((workgroup_idx / uniforms.num_N_tile) % uniforms.num_M_tile) * tile_size_m;
    let b_global_base = (workgroup_idx % uniforms.num_N_tile) * tile_size_n;

    // Each group of 16 threads computes one 16x16 output subtile.
    var subtile_id = u32(local_idx / subtile_size);
    var subtile_idx = u32(subtile_id / subtiles_n);
    var subtile_idy = u32(subtile_id % subtiles_n);
    var base_A = subtile_idx * 16;
    var base_B = subtile_idy * 16;
    // For each subtile we have 16 threads assigned.
    var a_idx = u32(local_idx % subtile_size);

#if is_qualcomm
    // Qualcomm uses four 64x16 subtiles or two 128x16 subtiles. Each lane
    // owns one activation row and accumulates 16 output columns.
    if (sg_size == tile_size_m) {
        subtile_id = u32(local_idx / sg_size);
        subtile_idx = u32(subtile_id / subtiles_n);
        subtile_idy = u32(subtile_id % subtiles_n);
        base_A = subtile_idx * sg_size;
        base_B = subtile_idy * 16;
        a_idx = sg_id;
    }
    var lane_outputs: array<acc_element_t, 16>;
#else
    var lane_output1: vec4<acc_element_t>;
    var lane_output2: vec4<acc_element_t>;
    var lane_output3: vec4<acc_element_t>;
    var lane_output4: vec4<acc_element_t>;
#endif
    // K's vectorization is 16 items per index. See input_a/input_b.
    // Load 32 or 128 K elements, represented by 2 or 8 vec4<u32> values.
    for (var kidx_v:u32 = 0; kidx_v < uniforms.K16; kidx_v+=tile_size_k_vec)
    {
        // Load Phase: Populate shared memory for the workgroup.
        for (var i = local_idx; i < (tile_size_m + tile_size_n) * tile_size_k_vec; i += workgroup_size) {
            if (i < tile_size_m * tile_size_k_vec) {
                loadSHMA(batch, a_global_base, kidx_v, i / tile_size_k_vec, i % tile_size_k_vec);
            } else {
                let j = i - tile_size_m * tile_size_k_vec;
                loadSHMB(b_global_base, kidx_v, j / tile_size_k_vec, j % tile_size_k_vec);
            }
        }
        workgroupBarrier();

        // Keep the original per-block scaling and accumulation order.
        for (var k_sub = 0u; k_sub < tile_size_k_vec / 2u; k_sub++) {
            // Step 1: Load from shared memory into registers across entire subgroup.
            var own_a0: vec4<u32> = tile_A[k_sub * 2u][base_A + a_idx];
            var own_a1: vec4<u32> = tile_A[k_sub * 2u + 1u][base_A + a_idx];
            var own_scale_a: output_element_t = scale_A[base_A + a_idx];

#if has_zero_points && n_bits == 8
 #if is_qualcomm
            if (sg_size == tile_size_m)
            {
                var own_b0: vec4<u32>;
                var own_b1: vec4<u32>;
                var own_scale_b: output_element_t;
                var zero: i32;
                if (sg_id < 16)
                {
                    own_b0 = tile_B[k_sub * 2u][base_B + sg_id];
                    own_b1 = tile_B[k_sub * 2u + 1u][base_B + sg_id];
                    own_scale_b = scale_B[k_sub * tile_size_n + base_B + sg_id];
                    zero = zeroes[k_sub * tile_size_n + base_B + sg_id];
                }
                // Step 2: Access registers across the subgroup using subgroupShuffle and perform the matmul.
                for (var i = 0u; i < 16u; i++)
                {
                    lane_outputs[i] += SDP8AI(own_a0, subgroupShuffle(own_b0, i), own_a1, subgroupShuffle(own_b1, i), subgroupShuffle(own_scale_b, i) * own_scale_a, subgroupShuffle(zero, i));
                }
            }
            else
            {
                for (var i = 0u; i < 16u; i++)
                {
                    lane_outputs[i] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + i], own_a1, tile_B[k_sub * 2u + 1u][base_B + i],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + i], zeroes[k_sub * tile_size_n + base_B + i]);
                }
            }
 #else
            if (sg_size == 16)
            {
                var own_b0: vec4<u32> = tile_B[k_sub * 2u][base_B + sg_id];
                var own_b1: vec4<u32> = tile_B[k_sub * 2u + 1u][base_B + sg_id];
                var own_scale_b: output_element_t  = scale_B[k_sub * tile_size_n + base_B + sg_id];
                var zero = zeroes[k_sub * tile_size_n + base_B + sg_id];
                // Step 2: Access registers across the subgroup using subgroupShuffle and perform the matmul.
                lane_output1[0] += SDP8AI(own_a0, subgroupShuffle(own_b0, 0), own_a1, subgroupShuffle(own_b1, 0), subgroupShuffle(own_scale_b, 0) * own_scale_a, subgroupShuffle(zero, 0));
                lane_output1[1] += SDP8AI(own_a0, subgroupShuffle(own_b0, 1), own_a1, subgroupShuffle(own_b1, 1), subgroupShuffle(own_scale_b, 1) * own_scale_a, subgroupShuffle(zero, 1));
                lane_output1[2] += SDP8AI(own_a0, subgroupShuffle(own_b0, 2), own_a1, subgroupShuffle(own_b1, 2), subgroupShuffle(own_scale_b, 2) * own_scale_a, subgroupShuffle(zero, 2));
                lane_output1[3] += SDP8AI(own_a0, subgroupShuffle(own_b0, 3), own_a1, subgroupShuffle(own_b1, 3), subgroupShuffle(own_scale_b, 3) * own_scale_a, subgroupShuffle(zero, 3));

                lane_output2[0] += SDP8AI(own_a0, subgroupShuffle(own_b0, 4), own_a1, subgroupShuffle(own_b1, 4), subgroupShuffle(own_scale_b, 4) * own_scale_a, subgroupShuffle(zero, 4));
                lane_output2[1] += SDP8AI(own_a0, subgroupShuffle(own_b0, 5), own_a1, subgroupShuffle(own_b1, 5), subgroupShuffle(own_scale_b, 5) * own_scale_a, subgroupShuffle(zero, 5));
                lane_output2[2] += SDP8AI(own_a0, subgroupShuffle(own_b0, 6), own_a1, subgroupShuffle(own_b1, 6), subgroupShuffle(own_scale_b, 6) * own_scale_a, subgroupShuffle(zero, 6));
                lane_output2[3] += SDP8AI(own_a0, subgroupShuffle(own_b0, 7), own_a1, subgroupShuffle(own_b1, 7), subgroupShuffle(own_scale_b, 7) * own_scale_a, subgroupShuffle(zero, 7));

                lane_output3[0] += SDP8AI(own_a0, subgroupShuffle(own_b0, 8), own_a1, subgroupShuffle(own_b1, 8), subgroupShuffle(own_scale_b, 8) * own_scale_a, subgroupShuffle(zero, 8));
                lane_output3[1] += SDP8AI(own_a0, subgroupShuffle(own_b0, 9), own_a1, subgroupShuffle(own_b1, 9), subgroupShuffle(own_scale_b, 9) * own_scale_a, subgroupShuffle(zero, 9));
                lane_output3[2] += SDP8AI(own_a0, subgroupShuffle(own_b0, 10), own_a1, subgroupShuffle(own_b1, 10), subgroupShuffle(own_scale_b, 10) * own_scale_a, subgroupShuffle(zero, 10));
                lane_output3[3] += SDP8AI(own_a0, subgroupShuffle(own_b0, 11), own_a1, subgroupShuffle(own_b1, 11), subgroupShuffle(own_scale_b, 11) * own_scale_a, subgroupShuffle(zero, 11));

                lane_output4[0] += SDP8AI(own_a0, subgroupShuffle(own_b0, 12), own_a1, subgroupShuffle(own_b1, 12), subgroupShuffle(own_scale_b, 12) * own_scale_a, subgroupShuffle(zero, 12));
                lane_output4[1] += SDP8AI(own_a0, subgroupShuffle(own_b0, 13), own_a1, subgroupShuffle(own_b1, 13), subgroupShuffle(own_scale_b, 13) * own_scale_a, subgroupShuffle(zero, 13));
                lane_output4[2] += SDP8AI(own_a0, subgroupShuffle(own_b0, 14), own_a1, subgroupShuffle(own_b1, 14), subgroupShuffle(own_scale_b, 14) * own_scale_a, subgroupShuffle(zero, 14));
                lane_output4[3] += SDP8AI(own_a0, subgroupShuffle(own_b0, 15), own_a1, subgroupShuffle(own_b1, 15), subgroupShuffle(own_scale_b, 15) * own_scale_a, subgroupShuffle(zero, 15));
            }
            else
            {
                // Code for other subgroup sizes, simply doesnt use subgroups at all.
                // Relies on reads from single location tile_B[][base_B + col] by all
                // being optimized by the hardware.
                lane_output1[0] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 0], own_a1, tile_B[k_sub * 2u + 1u][base_B + 0],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 0], zeroes[k_sub * tile_size_n + base_B + 0]);
                lane_output1[1] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 1], own_a1, tile_B[k_sub * 2u + 1u][base_B + 1],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 1], zeroes[k_sub * tile_size_n + base_B + 1]);
                lane_output1[2] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 2], own_a1, tile_B[k_sub * 2u + 1u][base_B + 2],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 2], zeroes[k_sub * tile_size_n + base_B + 2]);
                lane_output1[3] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 3], own_a1, tile_B[k_sub * 2u + 1u][base_B + 3],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 3], zeroes[k_sub * tile_size_n + base_B + 3]);

                lane_output2[0] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 4], own_a1, tile_B[k_sub * 2u + 1u][base_B + 4],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 4], zeroes[k_sub * tile_size_n + base_B + 4]);
                lane_output2[1] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 5], own_a1, tile_B[k_sub * 2u + 1u][base_B + 5],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 5], zeroes[k_sub * tile_size_n + base_B + 5]);
                lane_output2[2] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 6], own_a1, tile_B[k_sub * 2u + 1u][base_B + 6],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 6], zeroes[k_sub * tile_size_n + base_B + 6]);
                lane_output2[3] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 7], own_a1, tile_B[k_sub * 2u + 1u][base_B + 7],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 7], zeroes[k_sub * tile_size_n + base_B + 7]);

                lane_output3[0] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 8], own_a1, tile_B[k_sub * 2u + 1u][base_B + 8],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 8], zeroes[k_sub * tile_size_n + base_B + 8]);
                lane_output3[1] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 9], own_a1, tile_B[k_sub * 2u + 1u][base_B + 9],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 9], zeroes[k_sub * tile_size_n + base_B + 9]);
                lane_output3[2] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 10], own_a1, tile_B[k_sub * 2u + 1u][base_B + 10],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 10], zeroes[k_sub * tile_size_n + base_B + 10]);
                lane_output3[3] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 11], own_a1, tile_B[k_sub * 2u + 1u][base_B + 11],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 11], zeroes[k_sub * tile_size_n + base_B + 11]);

                lane_output4[0] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 12], own_a1, tile_B[k_sub * 2u + 1u][base_B + 12],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 12], zeroes[k_sub * tile_size_n + base_B + 12]);
                lane_output4[1] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 13], own_a1, tile_B[k_sub * 2u + 1u][base_B + 13],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 13], zeroes[k_sub * tile_size_n + base_B + 13]);
                lane_output4[2] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 14], own_a1, tile_B[k_sub * 2u + 1u][base_B + 14],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 14], zeroes[k_sub * tile_size_n + base_B + 14]);
                lane_output4[3] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 15], own_a1, tile_B[k_sub * 2u + 1u][base_B + 15],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 15], zeroes[k_sub * tile_size_n + base_B + 15]);
            }
 #endif
#else
 #if is_qualcomm
            if (sg_size == tile_size_m)
            {
                var own_b0: vec4<u32>;
                var own_b1: vec4<u32>;
                var own_scale_b: output_element_t;
                if (sg_id < 16)
                {
                    own_b0 = tile_B[k_sub * 2u][base_B + sg_id];
                    own_b1 = tile_B[k_sub * 2u + 1u][base_B + sg_id];
                    own_scale_b = scale_B[k_sub * tile_size_n + base_B + sg_id];
                }
                // Step 2: Access registers across the subgroup using subgroupShuffle and perform the matmul.
                for (var i = 0u; i < 16u; i++)
                {
                    lane_outputs[i] += SDP8AI(own_a0, subgroupShuffle(own_b0, i), own_a1, subgroupShuffle(own_b1, i), subgroupShuffle(own_scale_b, i) * own_scale_a);
                }
            }
            else
            {
                for (var i = 0u; i < 16u; i++)
                {
                    lane_outputs[i] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + i], own_a1, tile_B[k_sub * 2u + 1u][base_B + i],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + i]);
                }
            }
 #else
            if (sg_size == 16)
            {
                var own_b0: vec4<u32> = tile_B[k_sub * 2u][base_B + sg_id];
                var own_b1: vec4<u32> = tile_B[k_sub * 2u + 1u][base_B + sg_id];
                var own_scale_b: output_element_t  = scale_B[k_sub * tile_size_n + base_B + sg_id];
                // Step 2: Access registers across the subgroup using subgroupShuffle and perform the matmul.
                lane_output1[0] += SDP8AI(own_a0, subgroupShuffle(own_b0, 0), own_a1, subgroupShuffle(own_b1, 0), subgroupShuffle(own_scale_b, 0) * own_scale_a);
                lane_output1[1] += SDP8AI(own_a0, subgroupShuffle(own_b0, 1), own_a1, subgroupShuffle(own_b1, 1), subgroupShuffle(own_scale_b, 1) * own_scale_a);
                lane_output1[2] += SDP8AI(own_a0, subgroupShuffle(own_b0, 2), own_a1, subgroupShuffle(own_b1, 2), subgroupShuffle(own_scale_b, 2) * own_scale_a);
                lane_output1[3] += SDP8AI(own_a0, subgroupShuffle(own_b0, 3), own_a1, subgroupShuffle(own_b1, 3), subgroupShuffle(own_scale_b, 3) * own_scale_a);

                lane_output2[0] += SDP8AI(own_a0, subgroupShuffle(own_b0, 4), own_a1, subgroupShuffle(own_b1, 4), subgroupShuffle(own_scale_b, 4) * own_scale_a);
                lane_output2[1] += SDP8AI(own_a0, subgroupShuffle(own_b0, 5), own_a1, subgroupShuffle(own_b1, 5), subgroupShuffle(own_scale_b, 5) * own_scale_a);
                lane_output2[2] += SDP8AI(own_a0, subgroupShuffle(own_b0, 6), own_a1, subgroupShuffle(own_b1, 6), subgroupShuffle(own_scale_b, 6) * own_scale_a);
                lane_output2[3] += SDP8AI(own_a0, subgroupShuffle(own_b0, 7), own_a1, subgroupShuffle(own_b1, 7), subgroupShuffle(own_scale_b, 7) * own_scale_a);

                lane_output3[0] += SDP8AI(own_a0, subgroupShuffle(own_b0, 8), own_a1, subgroupShuffle(own_b1, 8), subgroupShuffle(own_scale_b, 8) * own_scale_a);
                lane_output3[1] += SDP8AI(own_a0, subgroupShuffle(own_b0, 9), own_a1, subgroupShuffle(own_b1, 9), subgroupShuffle(own_scale_b, 9) * own_scale_a);
                lane_output3[2] += SDP8AI(own_a0, subgroupShuffle(own_b0, 10), own_a1, subgroupShuffle(own_b1, 10), subgroupShuffle(own_scale_b, 10) * own_scale_a);
                lane_output3[3] += SDP8AI(own_a0, subgroupShuffle(own_b0, 11), own_a1, subgroupShuffle(own_b1, 11), subgroupShuffle(own_scale_b, 11) * own_scale_a);

                lane_output4[0] += SDP8AI(own_a0, subgroupShuffle(own_b0, 12), own_a1, subgroupShuffle(own_b1, 12), subgroupShuffle(own_scale_b, 12) * own_scale_a);
                lane_output4[1] += SDP8AI(own_a0, subgroupShuffle(own_b0, 13), own_a1, subgroupShuffle(own_b1, 13), subgroupShuffle(own_scale_b, 13) * own_scale_a);
                lane_output4[2] += SDP8AI(own_a0, subgroupShuffle(own_b0, 14), own_a1, subgroupShuffle(own_b1, 14), subgroupShuffle(own_scale_b, 14) * own_scale_a);
                lane_output4[3] += SDP8AI(own_a0, subgroupShuffle(own_b0, 15), own_a1, subgroupShuffle(own_b1, 15), subgroupShuffle(own_scale_b, 15) * own_scale_a);
            }
            else
            {
                // Code for other subgroup sizes, simply doesnt use subgroups at all.
                // Relies on reads from single location tile_B[][base_B + col] by all
                // being optimized by the hardware.
                lane_output1[0] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 0], own_a1, tile_B[k_sub * 2u + 1u][base_B + 0],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 0]);
                lane_output1[1] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 1], own_a1, tile_B[k_sub * 2u + 1u][base_B + 1],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 1]);
                lane_output1[2] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 2], own_a1, tile_B[k_sub * 2u + 1u][base_B + 2],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 2]);
                lane_output1[3] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 3], own_a1, tile_B[k_sub * 2u + 1u][base_B + 3],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 3]);

                lane_output2[0] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 4], own_a1, tile_B[k_sub * 2u + 1u][base_B + 4],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 4]);
                lane_output2[1] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 5], own_a1, tile_B[k_sub * 2u + 1u][base_B + 5],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 5]);
                lane_output2[2] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 6], own_a1, tile_B[k_sub * 2u + 1u][base_B + 6],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 6]);
                lane_output2[3] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 7], own_a1, tile_B[k_sub * 2u + 1u][base_B + 7],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 7]);

                lane_output3[0] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 8], own_a1, tile_B[k_sub * 2u + 1u][base_B + 8],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 8]);
                lane_output3[1] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 9], own_a1, tile_B[k_sub * 2u + 1u][base_B + 9],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 9]);
                lane_output3[2] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 10], own_a1, tile_B[k_sub * 2u + 1u][base_B + 10],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 10]);
                lane_output3[3] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 11], own_a1, tile_B[k_sub * 2u + 1u][base_B + 11],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 11]);

                lane_output4[0] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 12], own_a1, tile_B[k_sub * 2u + 1u][base_B + 12],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 12]);
                lane_output4[1] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 13], own_a1, tile_B[k_sub * 2u + 1u][base_B + 13],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 13]);
                lane_output4[2] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 14], own_a1, tile_B[k_sub * 2u + 1u][base_B + 14],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 14]);
                lane_output4[3] += SDP8AI(own_a0, tile_B[k_sub * 2u][base_B + 15], own_a1, tile_B[k_sub * 2u + 1u][base_B + 15],  own_scale_a * scale_B[k_sub * tile_size_n + base_B + 15]);
            }
 #endif
#endif
        }
        workgroupBarrier();
    }

    let a_global = a_global_base + base_A + a_idx;
    let b_global = b_global_base + base_B;
    let output_idx = (batch * uniforms.M * uniforms.N + a_global * uniforms.N + b_global)/4;
#if has_bias
#if has_weight_idx
#if has_weight_idx_indirect
    let actual_weight_idx_bias = weight_index_indirect[uniforms.weight_idx];
#else
    let actual_weight_idx_bias = uniforms.weight_idx;
#endif
    let b_bias_offset = actual_weight_idx_bias * uniforms.N;
#else
    const b_bias_offset : u32 = 0;
#endif
#endif
    // This creates a shader requirement that uniforms.N % 16 == 0
    if (a_global < uniforms.M && b_global < uniforms.N)
    {
#if is_qualcomm
 #if has_bias
        // Bias is added in acc_element_t and only downcast to output_element_t at the store,
        // so an f32 accumulator (acc_f32) stays in range through the bias add too.
        let bias_vec1 = vec4<acc_element_t>(
            acc_element_t(bias[b_global + 0 + b_bias_offset]),
            acc_element_t(bias[b_global + 1 + b_bias_offset]),
            acc_element_t(bias[b_global + 2 + b_bias_offset]),
            acc_element_t(bias[b_global + 3 + b_bias_offset])
        );
        let bias_vec2 = vec4<acc_element_t>(
            acc_element_t(bias[b_global + 4 + b_bias_offset]),
            acc_element_t(bias[b_global + 5 + b_bias_offset]),
            acc_element_t(bias[b_global + 6 + b_bias_offset]),
            acc_element_t(bias[b_global + 7 + b_bias_offset])
        );
        let bias_vec3 = vec4<acc_element_t>(
            acc_element_t(bias[b_global + 8 + b_bias_offset]),
            acc_element_t(bias[b_global + 9 + b_bias_offset]),
            acc_element_t(bias[b_global + 10 + b_bias_offset]),
            acc_element_t(bias[b_global + 11 + b_bias_offset])
        );
        let bias_vec4 = vec4<acc_element_t>(
            acc_element_t(bias[b_global + 12 + b_bias_offset]),
            acc_element_t(bias[b_global + 13 + b_bias_offset]),
            acc_element_t(bias[b_global + 14 + b_bias_offset]),
            acc_element_t(bias[b_global + 15 + b_bias_offset])
        );
        write_qlora_output(output_idx, vec4<output_element_t>(vec4<acc_element_t>(lane_outputs[0], lane_outputs[1], lane_outputs[2], lane_outputs[3]) + bias_vec1));
        write_qlora_output(output_idx+1, vec4<output_element_t>(vec4<acc_element_t>(lane_outputs[4], lane_outputs[5], lane_outputs[6], lane_outputs[7]) + bias_vec2));
        write_qlora_output(output_idx+2, vec4<output_element_t>(vec4<acc_element_t>(lane_outputs[8], lane_outputs[9], lane_outputs[10], lane_outputs[11]) + bias_vec3));
        write_qlora_output(output_idx+3, vec4<output_element_t>(vec4<acc_element_t>(lane_outputs[12], lane_outputs[13], lane_outputs[14], lane_outputs[15]) + bias_vec4));
 #else
        write_qlora_output(output_idx, vec4<output_element_t>(vec4<acc_element_t>(lane_outputs[0], lane_outputs[1], lane_outputs[2], lane_outputs[3])));
        write_qlora_output(output_idx+1, vec4<output_element_t>(vec4<acc_element_t>(lane_outputs[4], lane_outputs[5], lane_outputs[6], lane_outputs[7])));
        write_qlora_output(output_idx+2, vec4<output_element_t>(vec4<acc_element_t>(lane_outputs[8], lane_outputs[9], lane_outputs[10], lane_outputs[11])));
        write_qlora_output(output_idx+3, vec4<output_element_t>(vec4<acc_element_t>(lane_outputs[12], lane_outputs[13], lane_outputs[14], lane_outputs[15])));
 #endif
#else
 #if has_bias
        // TODO: wanted to use vec4 for bias but for some reason that fails ut. Later.
        // Bias is added in acc_element_t and only downcast to output_element_t at the store,
        // so an f32 accumulator (acc_f32) stays in range through the bias add too.
        let bias_vec1 = vec4<acc_element_t>(
            acc_element_t(bias[b_global + 0 + b_bias_offset]),
            acc_element_t(bias[b_global + 1 + b_bias_offset]),
            acc_element_t(bias[b_global + 2 + b_bias_offset]),
            acc_element_t(bias[b_global + 3 + b_bias_offset])
        );
        let bias_vec2 = vec4<acc_element_t>(
            acc_element_t(bias[b_global + 4 + b_bias_offset]),
            acc_element_t(bias[b_global + 5 + b_bias_offset]),
            acc_element_t(bias[b_global + 6 + b_bias_offset]),
            acc_element_t(bias[b_global + 7 + b_bias_offset])
        );
        let bias_vec3 = vec4<acc_element_t>(
            acc_element_t(bias[b_global + 8 + b_bias_offset]),
            acc_element_t(bias[b_global + 9 + b_bias_offset]),
            acc_element_t(bias[b_global + 10 + b_bias_offset]),
            acc_element_t(bias[b_global + 11 + b_bias_offset])
        );
        let bias_vec4 = vec4<acc_element_t>(
            acc_element_t(bias[b_global + 12 + b_bias_offset]),
            acc_element_t(bias[b_global + 13 + b_bias_offset]),
            acc_element_t(bias[b_global + 14 + b_bias_offset]),
            acc_element_t(bias[b_global + 15 + b_bias_offset])
        );
        write_qlora_output(output_idx, vec4<output_element_t>(lane_output1 + bias_vec1));
        write_qlora_output(output_idx+1, vec4<output_element_t>(lane_output2 + bias_vec2));
        write_qlora_output(output_idx+2, vec4<output_element_t>(lane_output3 + bias_vec3));
        write_qlora_output(output_idx+3, vec4<output_element_t>(lane_output4 + bias_vec4));
 #else
        write_qlora_output(output_idx, vec4<output_element_t>(lane_output1));
        write_qlora_output(output_idx+1, vec4<output_element_t>(lane_output2));
        write_qlora_output(output_idx+2, vec4<output_element_t>(lane_output3));
        write_qlora_output(output_idx+3, vec4<output_element_t>(lane_output4));
 #endif
#endif
    }
}  // MAIN
