#param head_size_param
#param num_heads_param
#param is_unidirectional
#param is_paged
#param q_bnsh
#param use_seqlen_k
#param use_seqlens_q

#use .getByIndices .setByOffset

const head_size: u32 = head_size_param;
const num_heads: u32 = num_heads_param;
// Uniform single-sequence chunks use direct cooperative loads. Four
// subgroups share a 32-query x 64-key tile, retaining their outputs in registers.
const q_rows: u32 = 32u;
const kv_rows: u32 = 64u;
var<workgroup> scores: array<f32, q_rows * kv_rows>;
var<workgroup> probabilities: array<f16, q_rows * kv_rows>;
var<workgroup> tail_values: array<f16, 4u * 256u>;
var<workgroup> row_max: array<f32, q_rows>;
var<workgroup> row_sum: array<f32, q_rows>;
var<workgroup> row_scale: array<f32, q_rows>;

$MAIN {
  let head = workgroup_idx / uniforms.num_seq_tile;
  let q_tile_start = (workgroup_idx % uniforms.num_seq_tile) * q_rows;
  // Shift a trailing tile inside Q so cooperative loads remain in bounds.
  let q_start = min(q_tile_start, uniforms.new_sequence_length - q_rows);
#if use_seqlens_q
  let q_length = u32(seqlens_q[0]);
#else
  let q_length = uniforms.new_sequence_length;
#endif
#if use_seqlen_k
#if is_paged
  let total_length = u32(seqlens_k[0]) + 1u;
#else
  let total_length = min(u32(max(seqlens_k[0], 0)) + 1u, uniforms.present_sequence_length);
#endif
#else
  let total_length = uniforms.total_sequence_length;
#endif
  let past_length = total_length - min(total_length, q_length);
  let sg = local_idx / 32u;
  let lane = local_idx % 32u;
  let q_block = sg / 2u;
  let n_block = sg % 2u;
#if q_bnsh
  let q_offset = (head * uniforms.new_sequence_length + q_start + q_block * 16u) * head_size;
  let q_stride = head_size;
#else
  let q_offset = ((q_start + q_block * 16u) * num_heads + head) * head_size;
  let q_stride = num_heads * head_size;
#endif
#if is_paged
  let kv_stride = uniforms.kv_num_heads * head_size;
#else
  let kv_stride = head_size;
#endif
  var output_values: array<f32, head_size / 4u>;
  if (local_idx < q_rows) {
    row_max[local_idx] = -3.402823466e+38f;
  }
#if is_unidirectional
  let loop_bound = min(total_length, past_length + q_start + q_rows);
#else
  let loop_bound = total_length;
#endif
  for (var k_start = 0u; k_start < loop_bound; k_start += kv_rows) {
    workgroupBarrier();
#if is_paged
    let page = u32(block_table.getByIndices(vec2<u32>(0u, k_start / uniforms.block_size)));
    let cache_base = ((page * uniforms.block_size + k_start % uniforms.block_size) *
                      uniforms.kv_num_heads + head / uniforms.n_reps) * head_size;
#else
    let cache_base = ((head / uniforms.n_reps) * uniforms.present_sequence_length + k_start) * head_size;
#endif
    var qk0 = subgroup_matrix_result<f32, 16, 16>(0.0f);
    var qk1 = subgroup_matrix_result<f32, 16, 16>(0.0f);
    for (var d = 0u; d < head_size; d += 16u) {
      let a = subgroupMatrixLoad<subgroup_matrix_left<f16, 16, 16>, row_major>(&q, q_offset + d, q_stride);
      let b0 = subgroupMatrixLoad<subgroup_matrix_right<f16, 16, 16>, col_major>(
          &key_cache, cache_base + n_block * 32u * kv_stride + d, kv_stride);
      let b1 = subgroupMatrixLoad<subgroup_matrix_right<f16, 16, 16>, col_major>(
          &key_cache, cache_base + (n_block * 32u + 16u) * kv_stride + d, kv_stride);
      qk0 = subgroupMatrixMultiplyAccumulate(a, b0, qk0);
      qk1 = subgroupMatrixMultiplyAccumulate(a, b1, qk1);
    }
    subgroupMatrixStore<row_major>(&scores, q_block * 16u * kv_rows + n_block * 32u, qk0, kv_rows);
    subgroupMatrixStore<row_major>(&scores, q_block * 16u * kv_rows + n_block * 32u + 16u, qk1, kv_rows);
    workgroupBarrier();
    let softmax_row = local_idx / 4u;
    let softmax_lane = local_idx % 4u;
#if is_unidirectional
    let visible = min(total_length, past_length + q_start + softmax_row + 1u);
#else
    let visible = total_length;
#endif
    var maximum = row_max[softmax_row];
    for (var k = softmax_lane; k < kv_rows; k += 4u) {
      if (k_start + k < visible) {
        maximum = max(maximum, scores[softmax_row * kv_rows + k] * uniforms.alpha);
      }
    }
    maximum = max(maximum, subgroupShuffleXor(maximum, 1u));
    maximum = max(maximum, subgroupShuffleXor(maximum, 2u));
    let rescale = exp(row_max[softmax_row] - maximum);
    var denominator = 0.0f;
    for (var k = softmax_lane; k < kv_rows; k += 4u) {
      var probability = 0.0f;
      if (k_start + k < visible) {
        probability = exp(scores[softmax_row * kv_rows + k] * uniforms.alpha - maximum);
      }
      probabilities[softmax_row * kv_rows + k] = f16(probability);
      denominator += probability;
    }
    denominator += subgroupShuffleXor(denominator, 1u);
    denominator += subgroupShuffleXor(denominator, 2u);
    if (softmax_lane == 0u) {
      row_max[softmax_row] = maximum;
      row_sum[softmax_row] = row_sum[softmax_row] * rescale + denominator;
      row_scale[softmax_row] = rescale;
    }
    workgroupBarrier();
    let output_row = q_block * 16u + lane / 2u;
    for (var d_index = 0u; d_index < head_size / 32u; d_index++) {
      let d = d_index * 32u + n_block * 16u;
      var pv = subgroup_matrix_result<f32, 16, 16>(0.0f);
      for (var k = 0u; k < kv_rows; k += 16u) {
        let a = subgroupMatrixLoad<subgroup_matrix_left<f16, 16, 16>, row_major>(
            &probabilities, q_block * 16u * kv_rows + k, kv_rows);
        if (k_start + k + 16u <= total_length) {
          let b = subgroupMatrixLoad<subgroup_matrix_right<f16, 16, 16>, row_major>(
              &value_cache, cache_base + k * kv_stride + d, kv_stride);
          pv = subgroupMatrixMultiplyAccumulate(a, b, pv);
        } else {
          // Metadata can overestimate the real length. Do not multiply zero
          // probabilities by uninitialized (possibly NaN) values beyond it.
          workgroupBarrier();
          for (var i = lane; i < 256u; i += 32u) {
            var value = f16(0);
            if (k_start + k + i / 16u < total_length) {
              value = value_cache[cache_base + (k + i / 16u) * kv_stride + d + i % 16u];
            }
            tail_values[sg * 256u + i] = value;
          }
          workgroupBarrier();
          let b = subgroupMatrixLoad<subgroup_matrix_right<f16, 16, 16>, row_major>(
              &tail_values, sg * 256u, 16u);
          pv = subgroupMatrixMultiplyAccumulate(a, b, pv);
          workgroupBarrier();
        }
      }
      // Scores are dead after softmax; reuse their first four tiles for PV.
      subgroupMatrixStore<row_major>(&scores, sg * 256u, pv, 16u);
      workgroupBarrier();
      for (var i = 0u; i < 8u; i++) {
        let index = d_index * 8u + i;
        output_values[index] = output_values[index] * row_scale[output_row] +
                               scores[sg * 256u + (lane / 2u) * 16u + (lane % 2u) * 8u + i];
      }
      workgroupBarrier();
    }
  }
  let output_row = q_block * 16u + lane / 2u;
  if (q_start + output_row < q_tile_start) {
    return;
  }
  for (var d_index = 0u; d_index < head_size / 32u; d_index++) {
    for (var v = 0u; v < 2u; v++) {
      let index = d_index * 8u + v * 4u;
      let value = output_value_t(vec4<f32>(output_values[index], output_values[index + 1u],
                                          output_values[index + 2u], output_values[index + 3u]) / row_sum[output_row]);
      let d = d_index * 32u + n_block * 16u + (lane % 2u) * 8u + v * 4u;
      output.setByOffset(((q_start + output_row) * num_heads * head_size + head * head_size + d) / 4u, value);
    }
  }
}
