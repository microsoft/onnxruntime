//
// SparsePagedAttention — merge the partial softmax states into one joint FP32
// softmax and write the activation-typed output.
//
// Each partial state is (accumulator[head_size], running_max, running_sum) in
// FP32. Merging two states with the standard online-softmax rule is exactly
// equivalent to running one softmax over the union of their candidates, so the
// main-cache and auxiliary-cache contributions compete in a single normalized
// distribution rather than being averaged after two independent softmaxes.
//
// The optional head sink seeds the merge with (max = sink, sum = 1,
// accumulator = 0), matching the CUDA kernel: the sink logit takes probability
// mass away from the real keys but contributes no value vector.
//
// Layout:
//   partial_main / partial_aux : (token_count, num_heads, head_size + 2)
//   head_sink                  : (num_heads,)
//   output                     : (token_count, num_heads * head_size)
//
#param has_main
#param has_auxiliary
#param has_head_sink

#use .getByOffset .setByOffset

const negative_infinity: f32 = -3.4028234663852886e38;

var<workgroup> final_sum: f32;
var<workgroup> main_weight: f32;
var<workgroup> auxiliary_weight: f32;

$MAIN {
  if (workgroup_idx >= uniforms.workgroup_count) {
    return;
  }

  let token_idx = workgroup_idx / uniforms.num_heads;
  let head_idx = workgroup_idx % uniforms.num_heads;
  let partial_base = (token_idx * uniforms.num_heads + head_idx) * (uniforms.head_size + 2u);

  if (local_idx == 0u) {
    var merged_max: f32 = negative_infinity;
    var sink_present = false;
    main_weight = 0.0;
    auxiliary_weight = 0.0;

#if has_head_sink
    let sink = f32(head_sink.getByOffset(head_idx));
    merged_max = max(merged_max, sink);
    sink_present = true;
#endif

#if has_main
    let main_max = partial_main.getByOffset(partial_base + uniforms.head_size);
    let main_sum = partial_main.getByOffset(partial_base + uniforms.head_size + 1u);
    if (main_sum > 0.0) {
      merged_max = max(merged_max, main_max);
    }
#endif

#if has_auxiliary
    let auxiliary_max = partial_auxiliary.getByOffset(partial_base + uniforms.head_size);
    let auxiliary_sum = partial_auxiliary.getByOffset(partial_base + uniforms.head_size + 1u);
    if (auxiliary_sum > 0.0) {
      merged_max = max(merged_max, auxiliary_max);
    }
#endif

    final_sum = 0.0;
#if has_head_sink
    if (sink_present) {
      final_sum = exp(sink - merged_max);
    }
#endif
#if has_main
    if (main_sum > 0.0) {
      main_weight = exp(main_max - merged_max);
      final_sum = final_sum + main_sum * main_weight;
    }
#endif
#if has_auxiliary
    if (auxiliary_sum > 0.0) {
      auxiliary_weight = exp(auxiliary_max - merged_max);
      final_sum = final_sum + auxiliary_sum * auxiliary_weight;
    }
#endif
  }
  workgroupBarrier();

  let output_base = (token_idx * uniforms.num_heads + head_idx) * uniforms.head_size;
  for (var dim_idx: u32 = local_idx; dim_idx < uniforms.head_size; dim_idx = dim_idx + workgroup_size_x) {
    var accumulator = 0.0;
#if has_main
    accumulator = accumulator + partial_main.getByOffset(partial_base + dim_idx) * main_weight;
#endif
#if has_auxiliary
    accumulator = accumulator + partial_auxiliary.getByOffset(partial_base + dim_idx) * auxiliary_weight;
#endif
    // A token with no valid candidate at all (and no sink) produces a zero row,
    // matching the CUDA kernel instead of emitting NaN.
    var result = 0.0;
    if (final_sum > 0.0) {
      result = accumulator / final_sum;
    }
    output.setByOffset(output_base + dim_idx, output_value_t(result));
  }
}
