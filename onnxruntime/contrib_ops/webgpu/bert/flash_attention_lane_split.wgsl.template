#param has_local_window
#param is_unidirectional
#param q_BNSH
#param qkv_head_size
#param qkv_num_heads
#param use_seqlen_k

#use .getByOffset .setByOffset

// Each 256-thread workgroup processes 32 queries with a 16-key tile.
const query_lanes: u32 = 8u;
const key_tile: u32 = 16u;
const num_heads: u32 = qkv_num_heads;
const head_vectors: u32 = qkv_head_size / 4;
var<workgroup> split_keys: array<q_value_t, key_tile * head_vectors>;
var<workgroup> split_values: array<q_value_t, key_tile * head_vectors>;

$MAIN {
  let batch_head = workgroup_idx / uniforms.num_seq_tile;
  let batch = batch_head / num_heads;
  if (batch >= uniforms.batch_size) {
    return;
  }
  let head = batch_head % num_heads;
  let lane = sg_id & (query_lanes - 1u);
  let query_tile = (workgroup_idx % uniforms.num_seq_tile) * (256u / query_lanes);
  let query = query_tile + local_idx / query_lanes;
  let valid = query < uniforms.new_sequence_length;
#if use_seqlen_k
  let total = min(u32(max(seqlens_k[batch], 0)) + 1u, uniforms.present_sequence_length);
#else
  let total = uniforms.total_sequence_length;
#endif
  let past = total - min(total, uniforms.new_sequence_length);
#if has_local_window
  let first_end = past + query_tile + 1u;
  let query_end = past + query + 1u;
  let left = query_end - min(query_end, uniforms.local_window_size);
  let first_key = (first_end - min(first_end, uniforms.local_window_size)) / key_tile * key_tile;
#else
  let left = 0u;
  let first_key = 0u;
#endif
#if is_unidirectional
  let bound = min(total, past + query_tile + 256u / query_lanes);
  let causal = min(total, past + query + 1u);
#else
  let bound = total;
  let causal = total;
#endif
#if q_BNSH
  let qbase = ((batch * num_heads + head) * uniforms.new_sequence_length + query) * head_vectors + lane;
#else
  let qbase = ((batch * uniforms.new_sequence_length + query) * num_heads + head) * head_vectors + lane;
#endif
  var q0 = q_value_t(0);
#if qkv_head_size > 32
  var q1 = q_value_t(0);
#endif
#if qkv_head_size > 64
  var q2 = q_value_t(0);
#endif
#if qkv_head_size > 96
  var q3 = q_value_t(0);
#endif
#if qkv_head_size > 128
  var q4 = q_value_t(0);
#endif
#if qkv_head_size > 160
  var q5 = q_value_t(0);
#endif
#if qkv_head_size > 192
  var q6 = q_value_t(0);
#endif
#if qkv_head_size > 224
  var q7 = q_value_t(0);
#endif
  if (valid) {
    let alpha = q_element_t(uniforms.alpha);
    q0 = q.getByOffset(qbase + 0u * query_lanes) * alpha;
#if qkv_head_size > 32
    q1 = q.getByOffset(qbase + 1u * query_lanes) * alpha;
#endif
#if qkv_head_size > 64
    q2 = q.getByOffset(qbase + 2u * query_lanes) * alpha;
#endif
#if qkv_head_size > 96
    q3 = q.getByOffset(qbase + 3u * query_lanes) * alpha;
#endif
#if qkv_head_size > 128
    q4 = q.getByOffset(qbase + 4u * query_lanes) * alpha;
#endif
#if qkv_head_size > 160
    q5 = q.getByOffset(qbase + 5u * query_lanes) * alpha;
#endif
#if qkv_head_size > 192
    q6 = q.getByOffset(qbase + 6u * query_lanes) * alpha;
#endif
#if qkv_head_size > 224
    q7 = q.getByOffset(qbase + 7u * query_lanes) * alpha;
#endif
  }
  var o0 = vec4<f32>(0);
#if qkv_head_size > 32
  var o1 = vec4<f32>(0);
#endif
#if qkv_head_size > 64
  var o2 = vec4<f32>(0);
#endif
#if qkv_head_size > 96
  var o3 = vec4<f32>(0);
#endif
#if qkv_head_size > 128
  var o4 = vec4<f32>(0);
#endif
#if qkv_head_size > 160
  var o5 = vec4<f32>(0);
#endif
#if qkv_head_size > 192
  var o6 = vec4<f32>(0);
#endif
#if qkv_head_size > 224
  var o7 = vec4<f32>(0);
#endif
  var previous_max = -3.4028234663852886e+38f;
  var denom = 0.0f;
  var scores: array<f32, key_tile>;
  let kvbase = (batch_head / uniforms.n_reps) * uniforms.present_sequence_length * head_vectors;
  for (var start = first_key; start < bound; start += key_tile) {
    workgroupBarrier();
    for (var idx = local_idx; idx < key_tile * head_vectors; idx += 256u) {
      let offset = kvbase + start * head_vectors + idx;
      if (start + idx / head_vectors < total) {
        split_keys[idx] = present_key.getByOffset(offset);
        split_values[idx] = present_value.getByOffset(offset);
      } else {
        split_keys[idx] = q_value_t(0);
        split_values[idx] = q_value_t(0);
      }
    }
    workgroupBarrier();
    var maximum = previous_max;
    for (var k = 0u; k < key_tile; k++) {
      let offset = k * head_vectors + lane;
      var score = dot(vec4<f32>(q0), vec4<f32>(split_keys[offset + 0u * query_lanes]));
#if qkv_head_size > 32
      score += dot(vec4<f32>(q1), vec4<f32>(split_keys[offset + 1u * query_lanes]));
#endif
#if qkv_head_size > 64
      score += dot(vec4<f32>(q2), vec4<f32>(split_keys[offset + 2u * query_lanes]));
#endif
#if qkv_head_size > 96
      score += dot(vec4<f32>(q3), vec4<f32>(split_keys[offset + 3u * query_lanes]));
#endif
#if qkv_head_size > 128
      score += dot(vec4<f32>(q4), vec4<f32>(split_keys[offset + 4u * query_lanes]));
#endif
#if qkv_head_size > 160
      score += dot(vec4<f32>(q5), vec4<f32>(split_keys[offset + 5u * query_lanes]));
#endif
#if qkv_head_size > 192
      score += dot(vec4<f32>(q6), vec4<f32>(split_keys[offset + 6u * query_lanes]));
#endif
#if qkv_head_size > 224
      score += dot(vec4<f32>(q7), vec4<f32>(split_keys[offset + 7u * query_lanes]));
#endif
      score += subgroupShuffle(score, sg_id ^ 1u);
      score += subgroupShuffle(score, sg_id ^ 2u);
      score += subgroupShuffle(score, sg_id ^ 4u);
      score = select(-3.4028234663852886e+38f, score, start + k >= left && start + k < causal);
      scores[k] = score;
      maximum = max(maximum, score);
    }
    let rescale = exp(previous_max - maximum);
    o0 *= rescale;
#if qkv_head_size > 32
    o1 *= rescale;
#endif
#if qkv_head_size > 64
    o2 *= rescale;
#endif
#if qkv_head_size > 96
    o3 *= rescale;
#endif
#if qkv_head_size > 128
    o4 *= rescale;
#endif
#if qkv_head_size > 160
    o5 *= rescale;
#endif
#if qkv_head_size > 192
    o6 *= rescale;
#endif
#if qkv_head_size > 224
    o7 *= rescale;
#endif
    denom *= rescale;
    for (var k = 0u; k < key_tile; k++) {
      let probability = select(0.0f, exp(scores[k] - maximum), start + k >= left && start + k < causal);
      denom += probability;
      let offset = k * head_vectors + lane;
      o0 += vec4<f32>(split_values[offset + 0u * query_lanes]) * probability;
#if qkv_head_size > 32
      o1 += vec4<f32>(split_values[offset + 1u * query_lanes]) * probability;
#endif
#if qkv_head_size > 64
      o2 += vec4<f32>(split_values[offset + 2u * query_lanes]) * probability;
#endif
#if qkv_head_size > 96
      o3 += vec4<f32>(split_values[offset + 3u * query_lanes]) * probability;
#endif
#if qkv_head_size > 128
      o4 += vec4<f32>(split_values[offset + 4u * query_lanes]) * probability;
#endif
#if qkv_head_size > 160
      o5 += vec4<f32>(split_values[offset + 5u * query_lanes]) * probability;
#endif
#if qkv_head_size > 192
      o6 += vec4<f32>(split_values[offset + 6u * query_lanes]) * probability;
#endif
#if qkv_head_size > 224
      o7 += vec4<f32>(split_values[offset + 7u * query_lanes]) * probability;
#endif
    }
    previous_max = maximum;
  }
  if (valid) {
    let offset = ((batch * uniforms.new_sequence_length + query) * num_heads + head) * head_vectors + lane;
    let divisor = select(1.0f, denom, denom > 0.0f);
    output.setByOffset(offset + 0u * query_lanes, q_value_t(o0 / divisor));
#if qkv_head_size > 32
    output.setByOffset(offset + 1u * query_lanes, q_value_t(o1 / divisor));
#endif
#if qkv_head_size > 64
    output.setByOffset(offset + 2u * query_lanes, q_value_t(o2 / divisor));
#endif
#if qkv_head_size > 96
    output.setByOffset(offset + 3u * query_lanes, q_value_t(o3 / divisor));
#endif
#if qkv_head_size > 128
    output.setByOffset(offset + 4u * query_lanes, q_value_t(o4 / divisor));
#endif
#if qkv_head_size > 160
    output.setByOffset(offset + 5u * query_lanes, q_value_t(o5 / divisor));
#endif
#if qkv_head_size > 192
    output.setByOffset(offset + 6u * query_lanes, q_value_t(o6 / divisor));
#endif
#if qkv_head_size > 224
    output.setByOffset(offset + 7u * query_lanes, q_value_t(o7 / divisor));
#endif
  }
}
