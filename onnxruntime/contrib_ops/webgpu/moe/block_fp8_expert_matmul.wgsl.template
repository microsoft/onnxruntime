#use .getByOffset .setByOffset

#param has_bias
#param has_indirect_experts
#param broadcast_input
#param use_matrix

#if use_matrix
var<workgroup> tile_a: array<f16, 1024>;
var<workgroup> tile_b: array<f16, 256>;
var<workgroup> tile_y: array<f32, 1024>;
var<workgroup> tile_partial: array<f32, 1024>;
#endif
$MAIN {
#if use_matrix
  let lane = local_idx;
  let row_base = workgroup_id.y * 64u;
  let col_base = workgroup_id.x * 16u;
  for (var i = lane; i < 1024u; i += 128u) {
    tile_y[i] = 0.0;
  }
  workgroupBarrier();
  for (var k_block = 0u; k_block < uniforms.scale_k_blocks; k_block++) {
    for (var i = lane; i < 1024u; i += 128u) {
      tile_partial[i] = 0.0;
    }
    workgroupBarrier();
    var acc = subgroupMatrixLoad<subgroup_matrix_result<f32, 16, 16>, row_major>(
        &tile_partial, subgroup_index * 256u, 16u);
    let block_start = k_block * 128u;
    let block_end = min(block_start + 128u, uniforms.inner);
    for (var k_base = block_start; k_base < block_end; k_base += 16u) {
      for (var i = lane; i < 1024u; i += 128u) {
        let row = row_base + i / 16u;
        let inner = k_base + i % 16u;
        tile_a[i] = f16(0);
        if (row < uniforms.rows && inner < uniforms.inner) {
#if broadcast_input
          tile_a[i] = f16(input.getByOffset(inner));
#else
          tile_a[i] = f16(input.getByOffset(row * uniforms.inner + inner));
#endif
        }
      }
      for (var i = lane; i < 256u; i += 128u) {
        let col = col_base + i / 16u;
        let inner = k_base + i % 16u;
        tile_b[i] = f16(0);
        if (col < uniforms.cols && inner < uniforms.inner) {
          let offset = uniforms.weight_byte_offset + col * uniforms.inner + inner;
          let code = (u32(weights.getByOffset(offset / 4u)) >> ((offset % 4u) * 8u)) & 255u;
          tile_b[i] = f16(bitcast<f32>(kFp8DequantLutBits[code]));
        }
      }
      workgroupBarrier();
      let left = subgroupMatrixLoad<subgroup_matrix_left<f16, 16, 16>, row_major>(
          &tile_a, subgroup_index * 256u, 16u);
      let right = subgroupMatrixLoad<subgroup_matrix_right<f16, 16, 16>, col_major>(&tile_b, 0u, 16u);
      acc = subgroupMatrixMultiplyAccumulate(left, right, acc);
      workgroupBarrier();
    }
    subgroupMatrixStore<row_major>(&tile_partial, subgroup_index * 256u, acc, 16u);
    workgroupBarrier();
    for (var i = lane; i < 1024u; i += 128u) {
      let col = col_base + i % 16u;
      if (col < uniforms.cols) {
        let scale = f32(scales.getByOffset((col / 128u) * uniforms.scale_k_blocks + k_block));
        tile_y[i] += tile_partial[i] * scale;
      }
    }
    workgroupBarrier();
  }
  for (var i = lane; i < 1024u; i += 128u) {
    let row = row_base + i / 16u;
    let col = col_base + i % 16u;
    if (row < uniforms.rows && col < uniforms.cols) {
      var value = tile_y[i];
#if has_bias
      value += f32(bias.getByOffset(col));
#endif
      output.setByOffset(row * uniforms.cols + col, output_element_t(value));
    }
  }
#else
  let row = global_id.y;
  let col = global_id.x;
  if (row >= uniforms.rows || col >= uniforms.cols) {
    return;
  }

#if has_indirect_experts
  let expert_idx = indirect_experts.getByOffset(row);
  let weight_base = (expert_idx * uniforms.cols + col) * uniforms.inner;
  let scale_base = expert_idx * uniforms.scale_n_blocks * uniforms.scale_k_blocks +
                   (col / 128u) * uniforms.scale_k_blocks;
#else
  let weight_base = uniforms.weight_byte_offset + col * uniforms.inner;
  let scale_base = (col / 128u) * uniforms.scale_k_blocks;
#endif
#if broadcast_input
  let input_row = 0u;
#else
  let input_row = row;
#endif

  var value = 0.0;
  for (var k_block = 0u; k_block < uniforms.scale_k_blocks; k_block++) {
    let scale = f32(scales.getByOffset(scale_base + k_block));
    let start = k_block * 128u;
    let end = min(start + 128u, uniforms.inner);
    for (var inner = start; inner < end; inner++) {
      let weight_offset = weight_base + inner;
      let packed_word = u32(weights.getByOffset(weight_offset / 4u));
      let weight_code = unpack4xU8(packed_word)[weight_offset % 4u];
      let weight = bitcast<f32>(kFp8DequantLutBits[weight_code]);
      value += f32(input.getByOffset(input_row * uniforms.inner + inner)) * weight * scale;
    }
  }
#if has_bias
#if has_indirect_experts
  value += f32(bias.getByOffset(expert_idx * uniforms.cols + col));
#else
  value += f32(bias.getByOffset(col));
#endif
#endif
  output.setByOffset(row * uniforms.cols + col, output_element_t(value));
#endif
} // MAIN
