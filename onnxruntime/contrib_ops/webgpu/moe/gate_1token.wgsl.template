//
// MOE 1 token gate shader
//
// called with expert as local_idx
// input: router_logits
// output: topk_values
// output: indirect_experts

#param is_fp16
#param k
#param has_router_weights
#param normalize_routing_weights
#param sort_experts
#param use_subgroups

#use .getByOffset .setByOffset

const K: u32 = k;
#if is_fp16
const MAX_FLOAT: f16 = 65504.0;
#else
const MAX_FLOAT: f32 = 3.4028234663852886e+38;
#endif

var<workgroup> shared_vals: array<router_logits_element_t, workgroup_size_x>;
var<workgroup> shared_idxs: array<u32, workgroup_size_x>;
#if normalize_routing_weights
var<workgroup> selected_vals: array<router_logits_element_t, K>;
var<workgroup> selected_idxs: array<u32, K>;
#endif

$MAIN {
    let row = workgroup_idx;
    if (row >= uniforms.rows) {
        return;
    }
    let cols = uniforms.cols;
    let output_base = row * cols;

    var max_val: router_logits_element_t = -MAX_FLOAT;
    var max_idx: u32 = 0u;

    if (local_idx < cols) {
        max_val = router_logits.getByOffset(row * cols + local_idx);
        max_idx = local_idx;
    }
    shared_vals[local_idx] = max_val;
    shared_idxs[local_idx] = max_idx;
    topk_values.setByOffset(output_base + local_idx, topk_values_value_t(0));
    workgroupBarrier();

#if normalize_routing_weights
    var candidate_val = max_val;
    var candidate_idx = local_idx;
    for (var i = 0u; i < K; i++) {
#if use_subgroups
        // Ordered integer keys reserve zero for removed candidates and retain -infinity.
        let value = f32(candidate_val);
        let bits = bitcast<u32>(select(value, 0.0, value == 0.0));
        let ordered_key = select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);
        let subgroup_key = subgroupMax(select(0u, ordered_key, candidate_idx < cols));
        let subgroup_expert = subgroupMin(select(0xffffffffu, candidate_idx,
                                                 candidate_idx < cols && ordered_key == subgroup_key));
        if (sg_id == 0u) {
            shared_vals[subgroup_index] = -MAX_FLOAT;
            if (subgroup_expert < cols) {
                shared_vals[subgroup_index] = router_logits.getByOffset(row * cols + subgroup_expert);
            }
            shared_idxs[subgroup_index] = subgroup_expert;
        }
        workgroupBarrier();
        if (local_idx == 0u) {
            var best_idx = cols;
            var best_val = -MAX_FLOAT;
            for (var group = 0u; group < (workgroup_size_x + sg_size - 1u) / sg_size; group++) {
                let expert = shared_idxs[group];
                let value = shared_vals[group];
                if (expert < cols && (best_idx >= cols || value > best_val ||
                                     (value == best_val && expert < best_idx))) {
                    best_val = value;
                    best_idx = expert;
                }
            }
            selected_vals[i] = best_val;
            selected_idxs[i] = best_idx;
        }
#else
        shared_vals[local_idx] = candidate_val;
        shared_idxs[local_idx] = candidate_idx;
        workgroupBarrier();
        for (var remaining = workgroup_size_x; remaining > 1u; remaining = (remaining + 1u) / 2u) {
            let stride = (remaining + 1u) / 2u;
            if (local_idx < remaining - stride) {
                let other = local_idx + stride;
                if (shared_idxs[local_idx] >= cols ||
                    (shared_idxs[other] < cols &&
                     (shared_vals[other] > shared_vals[local_idx] ||
                      (shared_vals[other] == shared_vals[local_idx] && shared_idxs[other] < shared_idxs[local_idx])))) {
                    shared_vals[local_idx] = shared_vals[other];
                    shared_idxs[local_idx] = shared_idxs[other];
                }
            }
            workgroupBarrier();
        }
        if (local_idx == 0u) {
            selected_vals[i] = shared_vals[0];
            selected_idxs[i] = shared_idxs[0];
        }
#endif
        workgroupBarrier();
        if (local_idx == selected_idxs[i]) {
            candidate_val = -MAX_FLOAT;
            candidate_idx = cols;
        }
#if !use_subgroups
        workgroupBarrier();
#endif
    }
    if (local_idx < K) {
        shared_vals[local_idx] = selected_vals[local_idx];
        shared_idxs[local_idx] = selected_idxs[local_idx];
    }
    workgroupBarrier();
#else
    for (var i = 0u; i < workgroup_size_x - 1u; i++) {
        for (var j = 0u; j < workgroup_size_x - 1u - i; j++) {
            if (local_idx == j && local_idx < cols && (local_idx + 1u) < cols) {
                // Compare adjacent elements and swap if needed (descending order)
                if (shared_vals[local_idx] < shared_vals[local_idx + 1u]) {
                    let temp_val = shared_vals[local_idx];
                    let temp_idx = shared_idxs[local_idx];
                    shared_vals[local_idx] = shared_vals[local_idx + 1u];
                    shared_idxs[local_idx] = shared_idxs[local_idx + 1u];
                    shared_vals[local_idx + 1u] = temp_val;
                    shared_idxs[local_idx + 1u] = temp_idx;
                }
            }
            workgroupBarrier();
        }
    }
#endif
    if (local_idx == 0u) {
#if has_router_weights
        var sum : f32 = 1.0;
#if normalize_routing_weights
        sum = 0.0;
        for (var i = 0u; i < K; i++) {
            sum += f32(router_weights.getByOffset(output_base + shared_idxs[i]));
        }
#endif
        for (var i = 0u; i < K; i++) {
            let expert_idx = shared_idxs[i];
            let weight = f32(router_weights.getByOffset(output_base + expert_idx));
            var normalized_weight = 0.0;
            if (sum != 0.0) {
                normalized_weight = weight / sum;
            }
            topk_values.setByOffset(output_base + expert_idx, topk_values_value_t(normalized_weight));
        }
#else
        // softmax with max-subtraction for numerical stability — without it, large
        // logits (e.g. >= ~89 for f32) cause exp() to overflow to +inf and the
        // ratio inf/inf becomes NaN, propagating through the rest of the kernel.
        // shared_vals is sorted in descending order, so shared_vals[0] is the max.
        let max_val = f32(shared_vals[0]);
        var sum : f32 = 0.0;
    #if normalize_routing_weights
        let normalization_count = K;
    #else
        let normalization_count = cols;
    #endif
        for (var i = 0u; i < normalization_count; i++) {
            sum += exp(f32(shared_vals[i]) - max_val);
        }
        for (var i = 0u; i < K; i++) {
            let expert_idx = shared_idxs[i];
            topk_values.setByOffset(output_base + expert_idx, topk_values_value_t(exp(f32(shared_vals[i]) - max_val) / sum));
        }
#endif
    #if sort_experts
        // Match the general path's expert-index accumulation order.
        for (var i = 0u; i < K; i++) {
            for (var j = 0u; j + i + 1u < K; j++) {
                if (shared_idxs[j] > shared_idxs[j + 1u]) {
                    let expert_idx = shared_idxs[j];
                    shared_idxs[j] = shared_idxs[j + 1u];
                    shared_idxs[j + 1u] = expert_idx;
                }
            }
        }
    #endif
        for (var i = 0u; i < K; i++) {
            indirect_experts.setByOffset(row * K + i, shared_idxs[i]);
        }
    }
} // MAIN
