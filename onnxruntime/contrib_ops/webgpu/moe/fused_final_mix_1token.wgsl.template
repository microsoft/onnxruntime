// Each workgroup row handles one token; routed expert rows are token-major.

#use .getByOffset .setByOffset

$MAIN {
    let row = workgroup_id.y;
    let out_idx = workgroup_id.x * workgroup_size_x + local_idx;
    if (out_idx >= uniforms.hidden_size) {
        return;
    }
    var acc = output_element_t(0);
    for (var i = 0u; i < uniforms.k; i++) {
        let routed_row = row * uniforms.k + i;
        let expert_idx = indirect_experts.getByOffset(routed_row);
        let router_value = router_values.getByOffset(row * uniforms.num_experts + expert_idx);
        acc += router_value * fc2_outputs.getByOffset(routed_row * uniforms.hidden_size + out_idx);
    }
    output.setByOffset(row * uniforms.hidden_size + out_idx, acc);
} // MAIN
