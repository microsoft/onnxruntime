load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

[
    config_setting(
        name = os,
        constraint_values = ["@platforms//os:" + os],
    )
    for os in [
        "linux",
        "windows",
        "macos",
    ]
]

[
    config_setting(
        name = cpu,
        constraint_values = ["@platforms//cpu:" + cpu],
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]

config_setting(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

exports_files([
    "onnx.BUILD.bazel",
    "abseil-includes.patch",
    "onnxruntime.lds",
    "python.lds",
    "requirements_lock.txt",
    "cuda_provider.lds",
])

bool_flag(
    name = "cuda",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "cuda_enabled",
    flag_values = {":cuda": "True"},
    visibility = ["//visibility:public"],
)
