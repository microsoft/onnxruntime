{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "onnxruntime",
  "version-date": "2025-01-31",
  "description": "ONNX Runtime: cross-platform, high performance ML inferencing and training accelerator",
  "homepage": "https://onnxruntime.ai/",
  "license": "MIT",
  "dependencies": [
    "abseil",
    {
      "name": "benchmark",
      "platform": "!android"
    },
    {
      "name": "boost-config",
      "version>=": "1.82.0"
    },
    {
      "name": "boost-mp11",
      "version>=": "1.82.0"
    },
    {
      "name": "cpuinfo",
      "platform": "!osx"
    },
    "cxxopts",
    "date",
    "dlpack",
    "eigen3",
    {
      "name": "flatbuffers",
      "host": true,
      "version>=": "23.5.26"
    },
    {
      "name": "flatbuffers",
      "version>=": "23.5.26"
    },
    {
      "name": "mimalloc",
      "platform": "windows"
    },
    {
      "name": "ms-gsl",
      "version>=": "4.2.1"
    },
    "nlohmann-json",
    "onnx",
    {
      "name": "protobuf",
      "version>=": "6.33.6"
    },
    {
      "name": "protobuf",
      "host": true,
      "version>=": "6.33.6"
    },
    "pybind11",
    "re2",
    "safeint",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "wil",
      "platform": "windows"
    },
    {
      "name": "zlib",
      "platform": "windows"
    }
  ],
  "features": {
    "coreml-ep": {
      "description": "Build with CoreML EP",
      "dependencies": [
        "fp16"
      ]
    },
    "dml-ep": {
      "description": "Build with DirectML EP",
      "dependencies": [
        "directx-headers"
      ]
    },
    "telemetry": {
      "description": "Build with static 1DS telemetry support",
      "dependencies": [
        {
          "name": "cpp-client-telemetry",
          "platform": "!android & !emscripten",
          "version>=": "3.10.240.1"
        },
        {
          "name": "curl",
          "default-features": false,
          "features": [
            "mbedtls"
          ],
          "platform": "linux"
        },
        {
          "name": "zlib",
          "platform": "android"
        }
      ]
    },
    "tests": {
      "description": "Build ONNXRuntime unit tests",
      "dependencies": [
        "gtest"
      ]
    },
    "webgpu-ep": {
      "description": "Build with WebGPU EP"
    },
    "xnnpack-ep": {
      "description": "Build with XNNPack EP",
      "dependencies": [
        "xnnpack"
      ]
    }
  },
  "overrides": [
    {
      "name": "benchmark",
      "version": "1.9.4"
    },
    {
      "name": "directx-headers",
      "version": "1.616.0"
    },
    {
      "name": "protobuf",
      "version": "6.33.6"
    },
    {
      "name": "flatbuffers",
      "version": "23.5.26"
    },
    {
      "name": "mimalloc",
      "version": "2.1.1"
    }
  ]
}
