vcpkg_check_linkage(ONLY_STATIC_LIBRARY)

# Release archive and hash from microsoft/vcpkg#54342; ORT policy remains in this overlay.
vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO microsoft/cpp_client_telemetry
    REF v3.10.281.1
    SHA512 934ac980096f571aa4eaeba5159ee87a687e32e174c548190c3926c5c29c1054f7b7924647457c8bcc97a78dd216651577dbb958a7895175d49a97784fb3bf51
    HEAD_REF main
)

set(MATSDK_BUILD_APPLE_HTTP OFF)
set(MATSDK_SQLITE_PROVIDER MINIMAL)
set(MATSDK_ZLIB_PROVIDER VENDORED)
if(VCPKG_TARGET_IS_OSX OR VCPKG_TARGET_IS_IOS)
  set(MATSDK_BUILD_APPLE_HTTP ON)
  set(MATSDK_SQLITE_PROVIDER SYSTEM)
  set(MATSDK_ZLIB_PROVIDER SYSTEM)
endif()
set(MATSDK_ENABLE_DEVICE_ID OFF)
if(VCPKG_TARGET_IS_ANDROID OR VCPKG_TARGET_IS_IOS)
  set(MATSDK_ENABLE_DEVICE_ID ON)
endif()
if(VCPKG_TARGET_IS_ANDROID)
  # The SDK's Java HTTP factory checks ANDROID, not the NDK's __ANDROID__ define.
  string(APPEND VCPKG_C_FLAGS " -DANDROID -DANDROID_SUPPRESS_LOGCAT")
  string(APPEND VCPKG_CXX_FLAGS " -DANDROID -DANDROID_SUPPRESS_LOGCAT")
endif()

vcpkg_cmake_configure(
    SOURCE_PATH "${SOURCE_PATH}"
    OPTIONS
        -DBUILD_SHARED_LIBS=OFF
        -DMATSDK_BUILD_HEADERS=ON
        -DMATSDK_BUILD_LIBRARY=ON
        -DMATSDK_BUILD_TEST_TOOL=OFF
        -DMATSDK_BUILD_UNIT_TESTS=OFF
        -DMATSDK_BUILD_FUNC_TESTS=OFF
        -DMATSDK_BUILD_PRIVACYGUARD=OFF
        -DMATSDK_BUILD_CDS=OFF
        -DMATSDK_BUILD_LIVEEVENTINSPECTOR=OFF
        -DMATSDK_BUILD_SIGNALS=OFF
        -DMATSDK_BUILD_SANITIZER=OFF
        -DMATSDK_BUILD_AZMON=OFF
        -DMATSDK_BUILD_JNI_WRAPPER=OFF
        -DMATSDK_BUILD_OBJC_WRAPPER=OFF
        -DMATSDK_BUILD_SWIFT_WRAPPER=OFF
        -DMATSDK_BUILD_PACKAGE=OFF
        -DMATSDK_DISABLE_LOGGING=ON
        -DMATSDK_ENABLE_DEVICE_ID=${MATSDK_ENABLE_DEVICE_ID}
        -DMATSDK_USE_WININET=OFF
        -DMATSDK_ANDROID_USE_ROOM=OFF
        -DMATSDK_ENABLE_CAPI_HTTP_CLIENT=OFF
        -DMATSDK_ANDROID_HTTP_CLIENT=JAVA
        -DBUILD_VERSION=${VERSION}
        -DMATSDK_BUILD_APPLE_HTTP=${MATSDK_BUILD_APPLE_HTTP}
        -DMATSDK_CURL_PROVIDER=SYSTEM
        -DMATSDK_CURL_TLS_BACKEND=MBEDTLS
        -DMATSDK_SQLITE_PROVIDER=${MATSDK_SQLITE_PROVIDER}
        -DMATSDK_ZLIB_PROVIDER=${MATSDK_ZLIB_PROVIDER}
)

vcpkg_cmake_install()
vcpkg_cmake_config_fixup(PACKAGE_NAME MSTelemetry CONFIG_PATH lib/cmake/MSTelemetry)

if(VCPKG_TARGET_IS_ANDROID)
  # ORT binds its Java bridge through the SDK's Android transport entry point.
  file(INSTALL "${SOURCE_PATH}/lib/http/HttpClient_Android.hpp"
       DESTINATION "${CURRENT_PACKAGES_DIR}/include/mat/http")
endif()

file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/debug/include")
file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/debug/share")

vcpkg_install_copyright(FILE_LIST "${SOURCE_PATH}/LICENSE")
file(INSTALL "${SOURCE_PATH}/LICENSE"
     DESTINATION "${CURRENT_PACKAGES_DIR}/share/MSTelemetry" RENAME LICENSE-1DS)
