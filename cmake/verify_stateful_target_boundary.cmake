function(onnxruntime_check_stateful_dependency origin target)
  get_target_property(alias "${target}" ALIASED_TARGET)
  if(alias)
    set(target "${alias}")
  endif()
  if(target MATCHES "(^|::)onnxruntime_stateful(_|$)")
    message(FATAL_ERROR "Stateful build boundary violated: ${origin} depends on ${target}")
  endif()
  get_property(visited GLOBAL PROPERTY ONNXRUNTIME_STATEFUL_BOUNDARY_VISITED)
  if(target IN_LIST visited)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY ONNXRUNTIME_STATEFUL_BOUNDARY_VISITED "${target}")

  foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_target_property(dependencies "${target}" "${property}")
    if(NOT dependencies)
      continue()
    endif()
    foreach(dependency IN LISTS dependencies)
      string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_.-]*(::[A-Za-z_][A-Za-z0-9_.-]*)?" names "${dependency}")
      foreach(name IN LISTS names)
        if(name MATCHES "(^|::)onnxruntime_stateful(_|$)")
          message(FATAL_ERROR
            "Stateful build boundary violated: ${origin} depends on ${name} through ${target}")
        endif()
        if(TARGET "${name}")
          onnxruntime_check_stateful_dependency("${origin}" "${name}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endfunction()

function(onnxruntime_check_stateful_target_boundary)
  set_property(GLOBAL PROPERTY ONNXRUNTIME_STATEFUL_BOUNDARY_VISITED "")
  foreach(target IN LISTS ARGN)
    if(TARGET "${target}")
      onnxruntime_check_stateful_dependency("${target}" "${target}")
    endif()
  endforeach()
endfunction()
