diff --git a/lib/api/LogManagerFactory.hpp b/lib/api/LogManagerFactory.hpp
--- a/lib/api/LogManagerFactory.hpp
+++ b/lib/api/LogManagerFactory.hpp
@@ -14,4 +14,5 @@
 #include <map>
+#include <new>
 #include <set>
 #include <string>
 #include <vector>
@@ -75,6 +76,8 @@
             // consumer observed this as EXC_BAD_ACCESS in release() at process
-            // exit). Leaking one small, fixed-size object avoids the ordering
-            // hazard entirely; the OS reclaims it when the process exits.
-            static LogManagerFactory& impl = *new LogManagerFactory();
-            return impl;
+            // exit). Keep the factory alive without a destructor, like GetPAL().
+            // Static storage also avoids leaking a heap allocation every time
+            // an embedding shared library is unloaded and reloaded.
+            alignas(LogManagerFactory) static unsigned char storage[sizeof(LogManagerFactory)];
+            static LogManagerFactory* impl = ::new (storage) LogManagerFactory();
+            return *impl;
         }
diff --git a/lib/api/AuthTokensController.cpp b/lib/api/AuthTokensController.cpp
--- a/lib/api/AuthTokensController.cpp
+++ b/lib/api/AuthTokensController.cpp
@@ -6,3 +6,4 @@
 #include "AuthTokensController.hpp"
+#include <new>
 #include "ILogManager.hpp"
 #include "utils/Utils.hpp"
@@ -25,5 +26,9 @@
     std::mutex& AuthTokensController::GetMutex()
     {
-        static std::mutex mutex;
-        return mutex;
+        // Like GetPAL(), this lock must survive late upload workers.
+        // libc++ can destroy a late-initialized mutex before a retained owner.
+        using AuthMutex = std::mutex;
+        alignas(AuthMutex) static unsigned char storage[sizeof(AuthMutex)];
+        static AuthMutex* mutex = ::new (storage) AuthMutex;
+        return *mutex;
     }
diff --git a/lib/pal/PAL.cpp b/lib/pal/PAL.cpp
--- a/lib/pal/PAL.cpp
+++ b/lib/pal/PAL.cpp
@@ -632,5 +632,10 @@
     const std::string& PlatformAbstractionLayer::getSdkVersion() const
     {
-        static const std::string sdkVersion(EVTSDK_VERSION_PREFIX "-" OS_NAME "-C++-" ECS_SUPP "-" BUILD_VERSION_STR);
-        return sdkVersion;
+        // Like GetPAL(), this immutable value must survive late upload workers.
+        // Telemetry can first be enabled after its exit owner was registered.
+        using SdkVersion = std::string;
+        alignas(SdkVersion) static unsigned char storage[sizeof(SdkVersion)];
+        static const SdkVersion* sdkVersion = ::new (storage)
+            SdkVersion(EVTSDK_VERSION_PREFIX "-" OS_NAME "-C++-" ECS_SUPP "-" BUILD_VERSION_STR);
+        return *sdkVersion;
     }
