+std::shared_mutex& OpSchemaRegistry::Mutex() {
+  static std::shared_mutex mutex;
+  return mutex;
+}
+
+void OpSchemaRegistry::RestoreDomainToVersionIfUnused(
+    const std::string& domain, bool had_original_range, int min_version, int max_version, int last_release_version) {
+  auto& schemas = map();
+  std::shared_lock lock(Mutex());
+  bool has_other_schemas = false;
+  for (const auto& [_, domain_map] : schemas) {
+    auto it = domain_map.find(domain);
+    if (it != domain_map.end() && !it->second.empty()) {
+      has_other_schemas = true;
+      break;
+    }
+  }
+  DomainToVersionRange::Instance().RestoreIfUnshared(
+      domain, has_other_schemas, had_original_range, min_version, max_version, last_release_version);
+}
