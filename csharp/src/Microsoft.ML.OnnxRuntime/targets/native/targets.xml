<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- ========================================================= -->
  <!-- Block unsupported 32-bit targets -->
  <!-- ========================================================= -->
  <Target Name="OnnxRuntime_BlockUnsupportedPlatform"
          BeforeTargets="Build"
          Condition="'$(PlatformTarget)' == 'x86' OR '$(Prefer32Bit)' == 'true'">
    <Error Text="Microsoft.ML.OnnxRuntime does not support 32-bit targets. Please use x64 or ARM64." />
  </Target>
</Project>
