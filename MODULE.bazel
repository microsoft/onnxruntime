module(name = "onnxruntime")

bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "33.6")
bazel_dep(name = "abseil-cpp", version = "20250814.0")
bazel_dep(name = "re2", version = "2024-07-02.bcr.1")
bazel_dep(name = "nlohmann_json", version = "3.11.3")
bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "rules_java", version = "8.16.1")
bazel_dep(name = "rules_python", version = "1.6.0")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "aspect_rules_js", version = "2.7.0")
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "rules_dotnet", version = "0.22.2")
bazel_dep(name = "rules_apple", version = "3.16.0")
single_version_override(
    module_name = "rules_apple",
    patch_strip = 1,
    patches = ["//bazel:rules-apple-platform-compatibility.patch"],
)
bazel_dep(name = "rules_rust", version = "0.65.0")
bazel_dep(name = "rules_rust_bindgen", version = "0.65.0")
single_version_override(
    module_name = "rules_rust_bindgen",
    patch_strip = 1,
    patches = ["//bazel/rust:bindgen-windows-import-library.patch"],
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2018",
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

register_toolchains("//bazel/rust:bindgen_toolchain")

rust_crates = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
rust_crates.from_cargo(
    name = "ort_rust_crates",
    cargo_lockfile = "//rust:Cargo.lock",
    lockfile = "//rust:Cargo.Bazel.lock",
    manifests = ["//rust:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(rust_crates, "ort_rust_crates")

rust_clang = use_extension("//bazel/rust:dependencies.bzl", "rust_clang_dependencies")
use_repo(rust_clang, "ort_rust_libclang")

bazel_dep(name = "rules_android_ndk", version = "0.1.5")

# Explicitly selected by --config=android_arm64; desktop builds need no NDK.
android_ndk_repository = use_repo_rule("@rules_android_ndk//:rules.bzl", "android_ndk_repository")

android_ndk_repository(
    name = "ort_android_ndk",
    api_level = 27,
)

csharp_test_deps = use_extension("//bazel:csharp_dependencies.bzl", "csharp_test_dependencies")
use_repo(
    csharp_test_deps,
    "google_protobuf",
    "newtonsoft_json",
    "xunit_abstractions",
    "xunit_assert",
    "xunit_extensibility_core",
    "xunit_extensibility_execution",
    "xunit_skippablefact",
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.22.1")
use_repo(node, "nodejs_toolchains")

register_toolchains("@nodejs_toolchains//:all")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "ort_node_npm",
    pnpm_lock = "//bazel/node:pnpm-lock.yaml",
    run_lifecycle_hooks = False,
)
use_repo(npm, "ort_node_npm")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.0")

single_version_override(
    module_name = "abseil-cpp",
    patch_strip = 1,
    patches = [
        "//bazel:abseil-includes.patch",
        "//:cmake/vcpkg-ports/abseil/absl_cuda_warnings.patch",
        "//:cmake/vcpkg-ports/abseil/absl_cuda13_member_template.patch",
    ],
)

ort_deps = use_extension("//bazel:dependencies.bzl", "ort_dependencies")
use_repo(ort_deps, "ort_date", "ort_eigen", "ort_flatbuffers", "ort_fp16", "ort_gsl", "ort_mp11", "ort_onnx", "ort_safeint")
use_repo(ort_deps, "ort_cudnn_frontend", "ort_cutlass")
use_repo(ort_deps, "ort_pybind11")
use_repo(ort_deps, "ort_node_addon_api", "ort_node_headers")
use_repo(ort_deps, "ort_node_import_library")
use_repo(ort_deps, "ort_dotnet_tensors")
use_repo(ort_deps, "ort_wil")
use_repo(ort_deps, "ort_mingw")
use_repo(ort_deps, "ort_junit", "ort_test_protobuf_java")

register_toolchains("//bazel:windows_cgo_toolchain")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.whl_mods(
    additive_build_content = """
load("@rules_cc//cc:cc_library.bzl", "cc_library")
cc_library(
    name = "numpy_headers",
    hdrs = glob(["site-packages/numpy/_core/include/**/*.h"]),
    includes = ["site-packages/numpy/_core/include"],
    visibility = ["//visibility:public"],
)
""",
    hub_name = "ort_numpy_mods",
    whl_name = "numpy",
)
use_repo(pip, "ort_numpy_mods")

pip.parse(
    extra_hub_aliases = {"numpy": ["numpy_headers"]},
    hub_name = "ort_pip",
    python_version = "3.12",
    requirements_lock = "//bazel:requirements.txt",
    whl_modifications = {"@ort_numpy_mods//:numpy.json": "numpy"},
)
use_repo(pip, "ort_pip")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")

cudnn = use_repo_rule("//bazel:local_sdk.bzl", "cudnn_repository")

cudnn(name = "ort_cudnn")
