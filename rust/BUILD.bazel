load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//bazel/rust:tests.bzl", "rust_selected_test")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "Cargo.Bazel.lock",
])

rust_test(
    name = "smoke_binary",
    srcs = ["//:tools/bazel/rust_smoke.rs"],
    compile_data = ["//:go/testdata/add_f32.onnx"],
    crate_root = "//:tools/bazel/rust_smoke.rs",
    edition = "2018",
    tags = ["manual"],
    deps = [
        "//rust/onnxruntime",
        "//rust/onnxruntime-sys:onnxruntime_sys",
    ],
)

rust_selected_test(
    name = "smoke_test",
    binary = ":smoke_binary",
    cases = [
        "current_c_api",
        "add_inference",
    ],
    manifest = "//rust/onnxruntime:Cargo.toml",
)

py_test(
    name = "test_runner_test",
    srcs = [
        "//:tools/bazel/rust_test_runner.py",
        "//:tools/bazel/rust_test_runner_test.py",
    ],
    main = "//:tools/bazel/rust_test_runner_test.py",
    deps = ["@rules_python//python/runfiles"],
)
