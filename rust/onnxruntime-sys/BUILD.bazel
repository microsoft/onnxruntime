load("@rules_rust//rust:defs.bzl", "rust_library")
load("@rules_rust_bindgen//:defs.bzl", "rust_bindgen")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_bindgen(
    name = "bindings",
    bindgen_flags = [
        "--dynamic-loading",
        "onnxruntime",
        "--allowlist-type",
        "Ort.*",
        "--allowlist-type",
        "Onnx.*",
        "--allowlist-type",
        "ONNX.*",
        "--allowlist-function",
        "Ort.*",
        "--allowlist-var",
        "ORT.*",
        "--rustified-enum",
        ".*",
    ],
    cc_lib = "//:api_headers",
    header = "//:include/onnxruntime/core/session/onnxruntime_c_api.h",
    merge_cc_lib_objects_into_rlib = False,
)

filegroup(
    name = "bindings_source",
    srcs = [":bindings"],
    output_group = "bindgen_bindings",
)

rust_library(
    name = "onnxruntime_sys",
    srcs = ["src/lib.rs"],
    compile_data = [":bindings_source"],
    crate_name = "onnxruntime_sys",
    crate_root = "src/lib.rs",
    data = ["//:runtime_library"],
    edition = "2018",
    rustc_env = {"OUT_DIR": "$${pwd}/$(BINDIR)/rust/onnxruntime-sys"},
    deps = ["@ort_rust_crates//:libloading"],
)
