+TEST(LogitsCastContract, AllocateReuseReplaceAndFallback) {
+  CountingDevice device{*GetDeviceInterface(DeviceType::CPU)};
+  for (bool fallback : {false, true}) {
+    device.fallback = fallback;
+    for (auto type : {ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT16, ONNX_TENSOR_ELEMENT_DATA_TYPE_BFLOAT16}) {
+      const std::array<int64_t, 3> shape{2, 1, 7};
+      auto input = OrtValue::CreateTensor(device.GetAllocator(), shape, type);
+      std::vector<float> expected(14, 3.5f);
+      ASSERT_TRUE(device.cpu.Cast(expected.data(), input->GetTensorMutableRawData(),
+                                 ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT, type, expected.size()));
+      std::unique_ptr<OrtValue> output;
+      Cast(*input, output, device, ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT);
+      const auto* first = output->GetTensorMutableRawData();
+      device.allocator.requests.clear();
+      Cast(*input, output, device, ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT);
+      EXPECT_EQ(output->GetTensorMutableRawData(), first);
+      EXPECT_TRUE(device.allocator.requests.empty());
+      const std::array<int64_t, 3> wrong_shape{2, 3, 7};
+      output = OrtValue::CreateTensor<float>(device.GetAllocator(), wrong_shape);
+      Cast(*input, output, device, ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT);
+      EXPECT_EQ(output->GetTensorTypeAndShapeInfo()->GetShape(), (std::vector<int64_t>{2, 1, 7}));
+      output = OrtValue::CreateTensor(device.GetAllocator(), shape, type);
+      Cast(*input, output, device, ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT);
+      const auto* values = output->GetTensorMutableData<float>();
+      for (size_t i = 0; i < expected.size(); ++i) EXPECT_EQ(values[i], expected[i]);
+    }
+  }
+  EXPECT_TRUE(device.allocator.live.empty());
+  EXPECT_FALSE(device.allocator.invalid_free);
+}
+
+TEST(LogitsPublicAPI, SnapshotIndependence) {
+  for (const char* fixture : {"tiny-random-gpt2-fp32", "tiny-random-gpt2-fp16-cuda"}) {
+    const auto path = std::filesystem::path(MODEL_PATH) / "hf-internal-testing" / fixture;
+    ASSERT_TRUE(std::filesystem::exists(path / "genai_config.json")) << path;
+    auto model = OgaModel::Create(path.c_str());
+    auto params = OgaGeneratorParams::Create(*model);
+    params->SetSearchOption("max_length", 10);
+    const std::vector<int32_t> ids{0, 0, 195, 731};
+    auto generator = OgaGenerator::Create(*model, *params);
+    generator->AppendTokens(ids.data(), ids.size());
+    auto snapshot = generator->GetLogits();
+    ASSERT_EQ(snapshot->Shape(), (std::vector<int64_t>{1, 1, 1000}));
+    std::vector<float> saved(1000);
+    std::memcpy(saved.data(), snapshot->Data(), saved.size() * sizeof(float));
+    generator->GenerateNextToken();
+    generator->GenerateNextToken();
+    auto later = generator->GetLogits();
+    EXPECT_NE(later->Data(), snapshot->Data());
+    generator.reset();
+    params.reset();
+    model.reset();
+    EXPECT_EQ(std::memcmp(saved.data(), snapshot->Data(), saved.size() * sizeof(float)), 0);
+  }
+}
