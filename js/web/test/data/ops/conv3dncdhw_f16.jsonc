// float16 coverage for Conv3D (NCDHW).
// Channel counts exercise every branch of the shader's inner loop:
//   C=1 scalar, C=4 vec4, C=6 vec4+vec2, C=7 vec4+vec3, plus padding and bias.
// All values are multiples of 0.5, so every partial sum is exact in float16 and
// the expected output does not depend on accumulation order.
[
  {
    "name": "conv3d float16, x=[1, 1, 2, 2, 2], f=[2, 1, 2, 2, 2], s=1, d=1, p=valid",
    "operator": "Conv",
    "attributes": [
      {
        "name": "kernel_shape",
        "data": [2, 2, 2],
        "type": "ints"
      },
      {
        "name": "auto_pad",
        "data": "VALID",
        "type": "string"
      },
      {
        "name": "strides",
        "data": [1, 1, 1],
        "type": "ints"
      },
      {
        "name": "dilations",
        "data": [1, 1, 1],
        "type": "ints"
      }
    ],
    "cases": [
      {
        "name": "T[0]",
        "inputs": [
          {
            "data": [-1.5, -1.0, 1.5, 0.5, -1.0, -0.5, -1.0, -1.5],
            "dims": [1, 1, 2, 2, 2],
            "type": "float16"
          },
          {
            "data": [-1.0, -1.0, -0.5, 0.5, -1.0, -1.0, -1.5, -1.0, -1.0, -0.5, -1.5, 0.5, 1.5, -1.0, 0.5, -1.5],
            "dims": [2, 1, 2, 2, 2],
            "type": "float16"
          }
        ],
        "outputs": [
          {
            "data": [6.5, 0.75],
            "dims": [1, 2, 1, 1, 1],
            "type": "float16"
          }
        ]
      }
    ]
  },
